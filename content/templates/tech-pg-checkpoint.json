{
  "schemaVersion": 1,
  "id": "tech-pg-checkpoint",
  "name": "Postgres: checkpoint storm",
  "description": "A write-heavy primary with a small max_wal_size (16 MB). Heavy writes force checkpoints back to back; full-page images after each one make the WAL even bigger.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 40
      },
      "config": {}
    },
    {
      "id": "app",
      "type": "service",
      "name": "app",
      "pos": {
        "x": 195,
        "y": 170
      },
      "config": {
        "instances": 4,
        "slots": 64,
        "p50Ms": 1,
        "p99Ms": 3
      }
    },
    {
      "id": "pg",
      "type": "pg-primary",
      "skin": "postgres-primary",
      "name": "primary",
      "pos": {
        "x": 195,
        "y": 320
      },
      "config": {
        "maxWalMb": 16,
        "diskMbps": 25
      }
    }
  ],
  "edges": [
    {
      "id": "e-users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "e-app-pg",
      "from": "app",
      "to": "pg"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 180,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 500
        },
        "readRatio": 0.5
      }
    ],
    "events": []
  },
  "wire": {
    "host": "ingest.sensorhub.io",
    "read": {
      "path": "/v1/sensors/{key}/latest",
      "body": "{\"sensor_id\": {key}, \"temp_c\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/readings",
      "reqBody": "{\"sensor_id\": {key}, \"temp_c\": {value}}",
      "status": 202,
      "body": "{\"accepted\": 1}"
    },
    "table": "readings",
    "valCol": "temp_c"
  }
}
