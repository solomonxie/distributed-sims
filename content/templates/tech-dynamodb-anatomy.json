{
  "schemaVersion": 1,
  "id": "tech-dynamodb-anatomy",
  "name": "DynamoDB: anatomy",
  "description": "DAX in front of a provisioned table: the request router, partitions spread over storage nodes (each with 3 AZ copies) and a GSI.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 239,
        "y": 20
      },
      "config": {}
    },
    {
      "id": "dax",
      "type": "cache",
      "name": "DAX",
      "pos": {
        "x": 239,
        "y": 100
      },
      "skin": "dynamodb-dax",
      "config": {}
    },
    {
      "id": "router",
      "type": "dynamodb-router",
      "name": "request router",
      "pos": {
        "x": 239,
        "y": 200
      },
      "config": {
        "mode": "provisioned",
        "rcu": 3000,
        "wcu": 1000,
        "gsiReadPct": 10,
        "minPartitions": 3
      }
    },
    {
      "id": "s1",
      "type": "dynamodb-storage",
      "name": "storage node 1",
      "pos": {
        "x": 70,
        "y": 330
      },
      "config": {}
    },
    {
      "id": "s2",
      "type": "dynamodb-storage",
      "name": "storage node 2",
      "pos": {
        "x": 239,
        "y": 330
      },
      "config": {}
    },
    {
      "id": "s3",
      "type": "dynamodb-storage",
      "name": "storage node 3",
      "pos": {
        "x": 408,
        "y": 330
      },
      "config": {}
    },
    {
      "id": "gsi",
      "type": "dynamodb-gsi",
      "name": "index by-status",
      "pos": {
        "x": 239,
        "y": 450
      },
      "config": {
        "wcu": 1000
      }
    }
  ],
  "edges": [
    {
      "id": "e-users-dax",
      "from": "users",
      "to": "dax"
    },
    {
      "id": "e-dax-router",
      "from": "dax",
      "to": "router"
    },
    {
      "id": "e-router-s1",
      "from": "router",
      "to": "s1"
    },
    {
      "id": "e-router-s2",
      "from": "router",
      "to": "s2"
    },
    {
      "id": "e-router-s3",
      "from": "router",
      "to": "s3"
    },
    {
      "id": "e-router-gsi",
      "from": "router",
      "to": "gsi"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 120,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 1000
        },
        "readRatio": 0.8
      }
    ],
    "events": []
  },
  "wire": {
    "host": "shop.example.com",
    "read": {
      "method": "GET",
      "path": "/api/orders/{key}",
      "status": 200,
      "body": "{\"order_id\": {key}, \"status\": \"{value}\"}"
    },
    "write": {
      "method": "PUT",
      "path": "/api/orders/{key}",
      "reqBody": "{\"status\": \"shipped\", \"items\": {value}}",
      "status": 200,
      "body": "{\"order_id\": {key}, \"version\": 2}"
    },
    "table": "orders",
    "valCol": "status",
    "cachePrefix": "order:"
  }
}