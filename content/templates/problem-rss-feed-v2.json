{
  "schemaVersion": 1,
  "id": "problem-rss-feed-v2",
  "name": "RSS reader: polite crawl + cached timelines",
  "description": "Due feeds go on a queue; a bounded fetch pool keeps each host under its crawl budget and dedupes items by GUID. Reads merge subscriptions on read, but hot feeds come from Redis.",
  "nodes": [
    {"id":"users","type":"mobile-client","skin":"ios-app","name":"Readers","pos":{"x":-80,"y":0}},
    {"id":"scheduler","type":"bot","name":"Feed scheduler","pos":{"x":96,"y":0}},
    {"id":"api","type":"service","skin":"node-service","name":"Reader API","pos":{"x":-80,"y":110},"config":{"instances":2}},
    {"id":"frontier","type":"queue","skin":"sqs","name":"Fetch queue","pos":{"x":96,"y":110},"config":{"ordering":"fifo","visibilityMs":5000,"maxReceives":100}},
    {"id":"redis","type":"cache","skin":"redis","name":"Feed cache","pos":{"x":-80,"y":220},"config":{"ttlSec":60,"capacityKeys":1024}},
    {"id":"fetchers","type":"worker","name":"Polite fetchers","pos":{"x":96,"y":220},"config":{"instances":3,"slots":4,"prefetch":2,"idempotent":true,"p50Ms":5,"p99Ms":20}},
    {"id":"db","type":"relational-db","skin":"postgres","name":"Feeds + items","pos":{"x":-80,"y":330},"config":{"p50Ms":15,"p99Ms":60}},
    {"id":"publishers","type":"external-api","name":"Publisher sites","pos":{"x":96,"y":330},"config":{"quotaRps":100,"p50Ms":200,"p99Ms":1200,"availabilityPct":99.5}}
  ],
  "edges": [
    {"id":"users-api","from":"users","to":"api","config":{"timeoutMs":5000}},
    {"id":"api-redis","from":"api","to":"redis"},
    {"id":"redis-db","from":"redis","to":"db"},
    {"id":"scheduler-frontier","from":"scheduler","to":"frontier","config":{"timeoutMs":5000}},
    {"id":"frontier-fetchers","from":"frontier","to":"fetchers"},
    {"id":"fetchers-publishers","from":"fetchers","to":"publishers","config":{"timeoutMs":3000}},
    {"id":"fetchers-redis","from":"fetchers","to":"redis"}
  ],
  "containers": [],
  "scenario": {"durationSec":60,"sources":[{"id":"readers","node":"users","shape":{"kind":"constant","rps":3000},"readRatio":1,"keys":{"kind":"zipf","s":1.1}},{"id":"due-feeds","node":"scheduler","shape":{"kind":"constant","rps":60},"readRatio":0,"keys":{"kind":"uniform"}}],"events":[]},
  "wire": {
    "host": "api.reader.example",
    "read": {
      "method": "GET",
      "path": "/v1/users/{key}/timeline",
      "status": 200,
      "body": "{\"items\": [{\"guid\": \"…\", \"title\": \"…\"}], \"unread\": 12}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/subscriptions",
      "reqBody": "{\"user_id\": {key}, \"feed_url\": \"https://blog.example.com/rss\"}",
      "status": 201,
      "body": "{\"feed_id\": {key}}"
    },
    "table": "feed_items",
    "valCol": "title",
    "cachePrefix": "feed:",
    "topic": "fetch-due"
  }
}
