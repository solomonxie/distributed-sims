  "containers": [],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s1",
        "node": "web",
        "shape": {
          "kind": "constant",
          "rps": 2400
        },
        "readRatio": 0.9,
        "keys": {
          "kind": "uniform"
        }
      }
    ],
    "events": []
  },
  "wire": {
    "host": "social.example",
    "read": {
      "path": "/api/users/{key}/profile"
    },
    "write": {
      "method": "POST",
      "path": "/api/users/{key}/follow",
      "reqBody": "{\"follower\": {value}}",
      "status": 201,
      "body": "{\"following\": true}"
    },
    "table": "profiles",
    "valCol": "follower_count"
  }
