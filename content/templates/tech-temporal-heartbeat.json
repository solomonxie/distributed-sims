{
  "schemaVersion": 1,
  "id": "tech-temporal-heartbeat",
  "name": "Temporal: activity heartbeats",
  "description": "Long activities (≈5s) heartbeat every second with a 2s heartbeat timeout; start-to-close is 60s. A dead worker is noticed in 2s, not 60s.",
  "nodes": [
    {
      "id": "app",
      "type": "web-client",
      "name": "Checkout app",
      "pos": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "frontend",
      "type": "temporal-frontend",
      "name": "Frontend",
      "pos": {
        "x": 0,
        "y": 120
      }
    },
    {
      "id": "history",
      "type": "temporal-history",
      "name": "History",
      "pos": {
        "x": -100,
        "y": 240
      }
    },
    {
      "id": "matching",
      "type": "temporal-matching",
      "name": "Matching",
      "pos": {
        "x": 100,
        "y": 240
      }
    },
    {
      "id": "db",
      "type": "temporal-persistence",
      "skin": "temporal-cassandra",
      "name": "Persistence",
      "pos": {
        "x": -100,
        "y": 360
      }
    },
    {
      "id": "worker-1",
      "type": "temporal-worker",
      "name": "Worker 1",
      "pos": {
        "x": 40,
        "y": 360
      },
      "config": {
        "actP50Ms": 5000,
        "actP99Ms": 8000,
        "heartbeatSec": 2,
        "startToCloseSec": 60
      }
    },
    {
      "id": "worker-2",
      "type": "temporal-worker",
      "name": "Worker 2",
      "pos": {
        "x": 150,
        "y": 360
      },
      "config": {
        "actP50Ms": 5000,
        "actP99Ms": 8000,
        "heartbeatSec": 2,
        "startToCloseSec": 60
      }
    }
  ],
  "edges": [
    {
      "id": "e-app",
      "from": "app",
      "to": "frontend"
    },
    {
      "id": "e-fh",
      "from": "frontend",
      "to": "history"
    },
    {
      "id": "e-fm",
      "from": "frontend",
      "to": "matching"
    },
    {
      "id": "e-hdb",
      "from": "history",
      "to": "db"
    },
    {
      "id": "e-hm",
      "from": "history",
      "to": "matching",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "e-w1",
      "from": "worker-1",
      "to": "frontend"
    },
    {
      "id": "e-w2",
      "from": "worker-2",
      "to": "frontend"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 180,
    "sources": [
      {
        "id": "starts",
        "node": "app",
        "shape": {
          "kind": "constant",
          "rps": 0.5
        },
        "readRatio": 1
      }
    ],
    "events": []
  },
  "wire": {
    "host": "api.clipforge.io",
    "read": {
      "path": "/v1/transcodes/{key}",
      "body": "{\"workflow_id\": \"transcode-{key}\", \"progress\": 0.6}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/transcodes",
      "reqBody": "{\"video_id\": {key}, \"preset\": \"1080p\"}",
      "status": 202,
      "body": "{\"workflow_id\": \"transcode-{key}\"}"
    }
  }
}
