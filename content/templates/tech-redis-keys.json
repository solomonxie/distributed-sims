{
  "schemaVersion": 1,
  "id": "tech-redis-keys",
  "name": "Redis: one slow command blocks everyone",
  "description": "10M keys, 20k ops/s. A single KEYS * (or a big DEL) runs on the only thread — every other client waits behind it.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 40
      }
    },
    {
      "id": "app",
      "type": "service",
      "name": "app",
      "pos": {
        "x": 195,
        "y": 160
      },
      "config": {
        "instances": 4,
        "slots": 256,
        "p50Ms": 0.2,
        "p99Ms": 1
      }
    },
    {
      "id": "redis",
      "type": "redis-server",
      "name": "redis primary",
      "pos": {
        "x": 195,
        "y": 290
      },
      "skin": "redis-internals"
    }
  ],
  "edges": [
    {
      "id": "users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "app-redis",
      "from": "app",
      "to": "redis",
      "config": {
        "timeoutMs": 3000
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 20000
        },
        "readRatio": 0.8
      }
    ],
    "events": []
  },
  "wire": {
    "host": "auth.notewise.app",
    "read": {
      "path": "/v1/tokens/{code}",
      "body": "{\"user_id\": {key}, \"scope\": \"notes:rw\"}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/tokens",
      "reqBody": "{\"user_id\": {key}, \"scope\": \"notes:rw\"}",
      "status": 201,
      "body": "{\"token\": \"{code}\", \"ttl\": 3600}"
    },
    "cachePrefix": "tok:"
  }
}
