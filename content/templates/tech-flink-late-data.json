    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 400
        },
        "readRatio": 0
      },
      {
        "id": "s2",
        "node": "phones",
        "shape": {
          "kind": "constant",
          "rps": 100
        },
        "readRatio": 0
      }
    ],
    "events": []
  },
  "wire": {
    "host": "app.example.com",
    "read": {
      "method": "GET",
      "path": "/api/users/{key}/sessions?window=1m",
      "status": 200,
      "body": "{\"user_id\": {key}, \"sessions\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/events",
      "reqBody": "{\"user_id\": {key}, \"event\": \"tap\", \"device_ts\": {value}}",
      "status": 202,
      "body": "{\"accepted\": 1}"
    },
    "topic": "app-events"
  }
