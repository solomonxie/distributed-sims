{
  "schemaVersion": 1,
  "id": "lesson-consensus-lease",
  "name": "Lesson: leader lease and a stale leader",
  "description": "5 etcd members serve lease reads: the leader answers reads locally while a majority acked it within the lease. etcd-1 has the shortest election timeout, so it leads first; it sits alone in Zone A.",
  "nodes": [
    {
      "id": "web",
      "type": "web-client",
      "name": "Clients",
      "pos": {
        "x": 195,
        "y": 40
      }
    },
    {
      "id": "api",
      "type": "service",
      "name": "Config API",
      "pos": {
        "x": 195,
        "y": 160
      },
      "config": {
        "fanout": "one"
      }
    },
    {
      "id": "etcd-1",
      "type": "consensus-member",
      "skin": "etcd",
      "name": "etcd-1",
      "parent": "az-a",
      "pos": {
        "x": 195,
        "y": 300
      },
      "config": {
        "reads": "lease",
        "electionMinMs": 300,
        "electionMaxMs": 350
      }
    },
    {
      "id": "etcd-2",
      "type": "consensus-member",
      "skin": "etcd",
      "name": "etcd-2",
      "parent": "az-b",
      "pos": {
        "x": 55,
        "y": 440
      },
      "config": {
        "reads": "lease"
      }
    },
    {
      "id": "etcd-3",
      "type": "consensus-member",
      "skin": "etcd",
      "name": "etcd-3",
      "parent": "az-b",
      "pos": {
        "x": 150,
        "y": 440
      },
      "config": {
        "reads": "lease"
      }
    },
    {
      "id": "etcd-4",
      "type": "consensus-member",
      "skin": "etcd",
      "name": "etcd-4",
      "parent": "az-b",
      "pos": {
        "x": 245,
        "y": 440
      },
      "config": {
        "reads": "lease"
      }
    },
    {
      "id": "etcd-5",
      "type": "consensus-member",
      "skin": "etcd",
      "name": "etcd-5",
      "parent": "az-b",
      "pos": {
        "x": 340,
        "y": 440
      },
      "config": {
        "reads": "lease"
      }
    }
  ],
  "edges": [
    {
      "id": "e0",
      "from": "web",
      "to": "api",
      "config": {
        "timeoutMs": 5000
      }
    },
    {
      "id": "e1",
      "from": "api",
      "to": "etcd-1",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "e2",
      "from": "api",
      "to": "etcd-2",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "e3",
      "from": "api",
      "to": "etcd-3",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "e4",
      "from": "api",
      "to": "etcd-4",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "e5",
      "from": "api",
      "to": "etcd-5",
      "config": {
        "timeoutMs": 3000
      }
    }
  ],
  "containers": [
    {
      "id": "az-a",
      "kind": "availability-zone",
      "name": "Zone A",
      "config": {
        "zone": "a"
      }
    },
    {
      "id": "az-b",
      "kind": "availability-zone",
      "name": "Zone B",
      "config": {
        "zone": "b"
      }
    }
  ],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s1",
        "node": "web",
        "shape": {
          "kind": "constant",
          "rps": 150
        },
        "readRatio": 0.7,
        "keys": {
          "kind": "zipf",
          "s": 1.2
        }
      }
    ],
    "events": []
  },
  "wire": {
    "host": "config.internal",
    "read": {
      "path": "/v3/kv/{key}",
      "body": "{\"key\": {key}, \"value\": {value}, \"revision\": 7}"
    },
    "write": {
      "method": "PUT",
      "path": "/v3/kv/{key}",
      "reqBody": "{\"value\": \"{value}\"}",
      "status": 200,
      "body": "{\"key\": {key}, \"revision\": 1}"
    }
  }
}