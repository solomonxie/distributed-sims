{
  "schemaVersion": 1,
  "id": "tech-es-anatomy",
  "name": "Elasticsearch: anatomy",
  "description": "A coordinating node, 3 master-eligible nodes and 3 data nodes. One index: 3 primary shards, 1 replica each.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 10
      },
      "config": {}
    },
    {
      "id": "app",
      "type": "es-app",
      "name": "app",
      "pos": {
        "x": 195,
        "y": 80
      },
      "config": {}
    },
    {
      "id": "coord",
      "type": "es-coord",
      "name": "coordinating",
      "pos": {
        "x": 195,
        "y": 170
      },
      "config": {}
    },
    {
      "id": "m1",
      "type": "es-master",
      "name": "master-1",
      "pos": {
        "x": 70,
        "y": 290
      },
      "config": {}
    },
    {
      "id": "m2",
      "type": "es-master",
      "name": "master-2",
      "pos": {
        "x": 195,
        "y": 290
      },
      "config": {}
    },
    {
      "id": "m3",
      "type": "es-master",
      "name": "master-3",
      "pos": {
        "x": 320,
        "y": 290
      },
      "config": {}
    },
    {
      "id": "d1",
      "type": "es-data",
      "name": "data-1",
      "pos": {
        "x": 70,
        "y": 420
      },
      "config": {}
    },
    {
      "id": "d2",
      "type": "es-data",
      "name": "data-2",
      "pos": {
        "x": 195,
        "y": 420
      },
      "config": {}
    },
    {
      "id": "d3",
      "type": "es-data",
      "name": "data-3",
      "pos": {
        "x": 320,
        "y": 420
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "e-users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "e-app-coord",
      "from": "app",
      "to": "coord"
    },
    {
      "id": "e-coord-d1",
      "from": "coord",
      "to": "d1",
      "config": {
        "timeoutMs": 1000
      }
    },
    {
      "id": "e-coord-d2",
      "from": "coord",
      "to": "d2",
      "config": {
        "timeoutMs": 1000
      }
    },
    {
      "id": "e-coord-d3",
      "from": "coord",
      "to": "d3",
      "config": {
        "timeoutMs": 1000
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 120,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 500
        },
        "readRatio": 0.8
      }
    ],
    "events": []
  },
  "wire": {
    "host": "shop.example.com",
    "read": {
      "method": "GET",
      "path": "/api/search?q=running+shoes&page={key}",
      "status": 200,
      "body": "{\"total\": 342, \"hits\": [{\"sku\": {key}}]}"
    },
    "write": {
      "method": "PUT",
      "path": "/api/products/{key}",
      "reqBody": "{\"title\": \"Trail Runner\", \"price\": {value}}",
      "status": 200,
      "body": "{\"sku\": {key}, \"indexed\": true}"
    }
  }
}