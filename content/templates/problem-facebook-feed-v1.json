{
  "schemaVersion": 1,
  "id": "problem-facebook-feed-v1",
  "name": "News feed: naive fan-out on write",
  "description": "Every post is copied synchronously into each follower's feed rows in the same Postgres that serves feed reads. A celebrity post means millions of inserts on one hot row range.",
  "nodes": [
    {"id":"users","type":"mobile-client","skin":"ios-app","name":"Readers","pos":{"x":-80,"y":0}},
    {"id":"authors","type":"mobile-client","skin":"android-app","name":"Posters","pos":{"x":96,"y":0}},
    {"id":"feed-api","type":"service","skin":"go-service","name":"Feed API","pos":{"x":-80,"y":110},"config":{"instances":2}},
    {"id":"post-api","type":"service","skin":"go-service","name":"Post API","pos":{"x":96,"y":110},"config":{"instances":2}},
    {"id":"db","type":"relational-db","skin":"postgres","name":"Feeds DB","pos":{"x":8,"y":220},"config":{"writeP50Ms":20,"writeP99Ms":80}}
  ],
  "edges": [
    {"id":"users-feed-api","from":"users","to":"feed-api","config":{"timeoutMs":3000}},
    {"id":"authors-post-api","from":"authors","to":"post-api","config":{"timeoutMs":3000}},
    {"id":"feed-api-db","from":"feed-api","to":"db"},
    {"id":"post-api-db","from":"post-api","to":"db"}
  ],
  "containers": [],
  "scenario": {"durationSec":60,"sources":[{"id":"feed-reads","node":"users","shape":{"kind":"constant","rps":6000},"readRatio":1,"keys":{"kind":"zipf","s":0.9}},{"id":"posts","node":"authors","shape":{"kind":"constant","rps":200},"readRatio":0,"keys":{"kind":"uniform"}}],"events":[]},
  "wire": {
    "host": "api.feed.example",
    "read": {
      "method": "GET",
      "path": "/v1/users/{key}/feed?limit=20",
      "status": 200,
      "body": "{\"user_id\": {key}, \"posts\": [{\"id\": 9001, \"text\": \"…\"}], \"cursor\": \"c20\"}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/posts",
      "reqBody": "{\"author_id\": {key}, \"text\": \"hello world\"}",
      "status": 201,
      "body": "{\"post_id\": {key}, \"created_at\": \"2026-09-27T09:00:00Z\"}"
    },
    "table": "feed_items",
    "valCol": "post_id"
  }
}
