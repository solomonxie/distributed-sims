{
  "schemaVersion": 1,
  "id": "tech-redis-io-threads",
  "name": "Redis: io-threads",
  "description": "80k ops/s each. Left: 1 thread does parse + exec + write. Right: 4 io-threads share parse/write; exec is still one thread.",
  "nodes": [
    {
      "id": "users-a",
      "type": "web-client",
      "name": "Users 1 thread",
      "pos": {
        "x": 110,
        "y": 40
      }
    },
    {
      "id": "app-a",
      "type": "service",
      "name": "app",
      "pos": {
        "x": 110,
        "y": 160
      },
      "config": {
        "instances": 4,
        "slots": 256,
        "p50Ms": 0.2,
        "p99Ms": 1
      }
    },
    {
      "id": "r1",
      "type": "redis-server",
      "name": "io-threads 1",
      "pos": {
        "x": 110,
        "y": 290
      },
      "skin": "redis-internals",
      "config": {
        "ioThreads": 1
      }
    },
    {
      "id": "users-b",
      "type": "web-client",
      "name": "Users 4 io-threads",
      "pos": {
        "x": 280,
        "y": 40
      }
    },
    {
      "id": "app-b",
      "type": "service",
      "name": "app",
      "pos": {
        "x": 280,
        "y": 160
      },
      "config": {
        "instances": 4,
        "slots": 256,
        "p50Ms": 0.2,
        "p99Ms": 1
      }
    },
    {
      "id": "r4",
      "type": "redis-server",
      "name": "io-threads 4",
      "pos": {
        "x": 280,
        "y": 290
      },
      "skin": "redis-internals",
      "config": {
        "ioThreads": 4,
        "cluster": "r2"
      }
    }
  ],
  "edges": [
    {
      "id": "users-a-app-a",
      "from": "users-a",
      "to": "app-a",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "app-a-r1",
      "from": "app-a",
      "to": "r1",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "users-b-app-b",
      "from": "users-b",
      "to": "app-b",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "app-b-r4",
      "from": "app-b",
      "to": "r4",
      "config": {
        "timeoutMs": 3000
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s-a",
        "node": "users-a",
        "shape": {
          "kind": "constant",
          "rps": 80000
        },
        "readRatio": 0.8
      },
      {
        "id": "s-b",
        "node": "users-b",
        "shape": {
          "kind": "constant",
          "rps": 80000
        },
        "readRatio": 0.8
      }
    ],
    "events": []
  },
  "wire": {
    "host": "bid.adserve.net",
    "read": {
      "path": "/v1/bid?slot={key}",
      "body": "{\"slot\": {key}, \"cpm_micros\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/impressions",
      "reqBody": "{\"campaign_id\": {key}}",
      "status": 204,
      "body": ""
    },
    "cachePrefix": "cap:"
  }
}
