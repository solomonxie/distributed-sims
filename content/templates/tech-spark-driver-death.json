{
  "schemaVersion": 1,
  "id": "tech-spark-driver-death",
  "name": "Spark: driver death",
  "description": "The driver holds the DAG and shuffle map. Kill it and the running job is lost, even though every executor is fine.",
  "nodes": [
    {
      "id": "driver",
      "type": "spark-driver",
      "skin": "spark-driver-std",
      "name": "Driver",
      "pos": {
        "x": 195,
        "y": 60
      },
      "config": {
        "cronSec": 8,
        "stages": 4,
        "inputMb": 3072
      }
    },
    {
      "id": "exec-1",
      "type": "spark-executor",
      "skin": "spark-executor-std",
      "name": "Executor 1",
      "pos": {
        "x": 55,
        "y": 220
      },
      "config": {}
    },
    {
      "id": "exec-2",
      "type": "spark-executor",
      "skin": "spark-executor-std",
      "name": "Executor 2",
      "pos": {
        "x": 195,
        "y": 220
      },
      "config": {}
    },
    {
      "id": "exec-3",
      "type": "spark-executor",
      "skin": "spark-executor-std",
      "name": "Executor 3",
      "pos": {
        "x": 335,
        "y": 220
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "d-e1",
      "from": "driver",
      "to": "exec-1"
    },
    {
      "id": "d-e2",
      "from": "driver",
      "to": "exec-2"
    },
    {
      "id": "d-e3",
      "from": "driver",
      "to": "exec-3"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 120,
    "sources": [],
    "events": []
  },
  "wire": {
    "host": "spark-master.internal:6066",
    "read": {
      "path": "/v1/submissions/status/driver-{key}",
      "body": "{\"driverState\": \"RUNNING\", \"success\": true}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/submissions/create",
      "reqBody": "{\"mainClass\": \"clicks.Sessionize\", \"appArgs\": [\"s3://logs/clicks\"]}",
      "status": 200,
      "body": "{\"submissionId\": \"driver-{key}\", \"success\": true}"
    },
    "table": "sessions",
    "valCol": "page_views"
  }
}
