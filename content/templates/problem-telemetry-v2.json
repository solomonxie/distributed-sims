{
  "schemaVersion": 1,
  "id": "problem-telemetry-v2",
  "name": "Telemetry — reference",
  "description": "Ingest writes to Kafka and returns; aggregators downsample and drop high-cardinality labels before the TSDB, so a label explosion only grows lag.",
  "nodes": [
    {
      "id": "users",
      "type": "iot-device",
      "skin": "sensor",
      "name": "Hosts (agents)",
      "pos": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "ingest",
      "type": "service",
      "skin": "go-service",
      "name": "Ingest API",
      "pos": {
        "x": -80,
        "y": 110
      },
      "config": {
        "instances": 3
      }
    },
    {
      "id": "query",
      "type": "service",
      "skin": "go-service",
      "name": "Query API",
      "pos": {
        "x": 90,
        "y": 110
      },
      "config": {
        "instances": 2
      }
    },
    {
      "id": "buffer",
      "type": "log-stream",
      "skin": "kafka",
      "name": "Metrics buffer",
      "pos": {
        "x": -80,
        "y": 220
      },
      "config": {
        "partitions": 12,
        "maxRecordsPerPartition": 100000
      }
    },
    {
      "id": "agg",
      "type": "worker",
      "name": "Aggregator (downsample)",
      "pos": {
        "x": -80,
        "y": 330
      },
      "config": {
        "instances": 4,
        "slots": 32,
        "p50Ms": 1,
        "p99Ms": 5,
        "idempotent": true
      }
    },
    {
      "id": "tsdb",
      "type": "time-series-db",
      "skin": "prometheus-tsdb",
      "name": "TSDB",
      "pos": {
        "x": 0,
        "y": 440
      },
      "config": {
        "cardinality": 250000,
        "memoryMb": 32768
      }
    }
  ],
  "edges": [
    {
      "id": "users->ingest",
      "from": "users",
      "to": "ingest",
      "config": {
        "op": "write"
      }
    },
    {
      "id": "users->query",
      "from": "users",
      "to": "query",
      "config": {
        "op": "read"
      }
    },
    {
      "id": "ingest->buffer",
      "from": "ingest",
      "to": "buffer"
    },
    {
      "id": "buffer->agg",
      "from": "buffer",
      "to": "agg"
    },
    {
      "id": "agg->tsdb",
      "from": "agg",
      "to": "tsdb"
    },
    {
      "id": "query->tsdb",
      "from": "query",
      "to": "tsdb"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 60,
    "sources": [
      {
        "id": "agents",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 2000
        },
        "readRatio": 0
      },
      {
        "id": "dashboards",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 50
        },
        "readRatio": 1
      }
    ],
    "events": []
  },
  "wire": {
    "host": "ingest.metrics.example",
    "read": {
      "method": "GET",
      "path": "/api/v1/query?query=cpu_usage&device={key}",
      "status": 200,
      "body": "{\"status\": \"success\", \"data\": {\"result\": [{\"value\": [1767225600, \"0.42\"]}]}}"
    },
    "write": {
      "method": "POST",
      "path": "/api/v1/write",
      "reqBody": "{\"device\": {key}, \"metric\": \"cpu_usage\", \"value\": {value}}",
      "status": 204,
      "body": ""
    },
    "table": "samples",
    "valCol": "value",
    "topic": "metrics-raw"
  }
}
