{
  "schemaVersion": 1,
  "id": "lesson-paradigm-cqrs",
  "name": "CQRS: write model + read projection",
  "description": "Commands go to the write service and Postgres; each change is published to Kafka and a projector updates a denormalised read store. Queries hit only the read side. The two sides scale and fail independently; the gap between them is projection lag.",
  "nodes": [
    {
      "id": "web",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 239,
        "y": 20
      },
      "skin": "react-spa"
    },
    {
      "id": "api",
      "type": "service",
      "name": "API",
      "pos": {
        "x": 239,
        "y": 110
      },
      "skin": "go-service"
    },
    {
      "id": "cmd",
      "type": "service",
      "name": "Write service",
      "pos": {
        "x": 70,
        "y": 210
      },
      "skin": "java-service",
      "config": {
        "gcPauses": false
      }
    },
    {
      "id": "pg",
      "type": "relational-db",
      "name": "Write DB",
      "pos": {
        "x": 70,
        "y": 320
      },
      "skin": "postgres"
    },
    {
      "id": "k",
      "type": "log-stream",
      "name": "Changes",
      "pos": {
        "x": 239,
        "y": 320
      },
      "skin": "kafka"
    },
    {
      "id": "proj",
      "type": "worker",
      "name": "Projector",
      "pos": {
        "x": 239,
        "y": 430
      },
      "config": {
        "instances": 2,
        "slots": 4,
        "p50Ms": 5,
        "p99Ms": 15
      }
    },
    {
      "id": "q",
      "type": "service",
      "name": "Query service",
      "pos": {
        "x": 408,
        "y": 210
      },
      "skin": "go-service"
    },
    {
      "id": "rd",
      "type": "document-db",
      "name": "Read store",
      "pos": {
        "x": 408,
        "y": 430
      },
      "skin": "mongodb"
    }
  ],
  "edges": [
    {
      "id": "web->api",
      "from": "web",
      "to": "api"
    },
    {
      "id": "api->cmd",
      "from": "api",
      "to": "cmd",
      "config": {
        "op": "write"
      }
    },
    {
      "id": "api->q",
      "from": "api",
      "to": "q",
      "config": {
        "op": "read"
      }
    },
    {
      "id": "cmd->pg",
      "from": "cmd",
      "to": "pg"
    },
    {
      "id": "cmd->k",
      "from": "cmd",
      "to": "k",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "k->proj",
      "from": "k",
      "to": "proj"
    },
    {
      "id": "proj->rd",
      "from": "proj",
      "to": "rd"
    },
    {
      "id": "q->rd",
      "from": "q",
      "to": "rd",
      "config": {
        "op": "read"
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 60,
    "sources": [
      {
        "id": "s",
        "node": "web",
        "shape": {
          "kind": "constant",
          "rps": 300
        },
        "readRatio": 0.8
      }
    ],
    "events": []
  },
  "wire": {
    "host": "shop.example",
    "read": {
      "path": "/api/orders/{key}/summary"
    },
    "write": {
      "method": "POST",
      "path": "/api/orders",
      "reqBody": "{\"sku\": \"SKU-{key}\", \"qty\": 1}",
      "status": 201,
      "body": "{\"order_id\": {key}, \"status\": \"placed\"}"
    },
    "table": "orders",
    "valCol": "status",
    "topic": "order-changes"
  }
}
