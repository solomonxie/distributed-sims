{
  "schemaVersion": 1,
  "id": "data-replication",
  "name": "Replication lag & failover",
  "description": "Postgres primary with 2 async replicas; reads go to replicas. Replica lag makes reads stale; killing the primary loses acknowledged writes that never reached a replica. Set replication to sync and compare.",
  "nodes": [
    { "id": "web", "type": "web-client", "name": "Users", "pos": { "x": 195, "y": 60 } },
    { "id": "api", "type": "service", "name": "API", "pos": { "x": 195, "y": 200 } },
    { "id": "db", "type": "relational-db", "skin": "postgres", "name": "Postgres", "pos": { "x": 195, "y": 340 }, "config": { "replicas": 2, "replication": "async", "readFrom": "replicas", "replicaLagMs": 100, "failoverSec": 10 } }
  ],
  "edges": [
    { "id": "e1", "from": "web", "to": "api" },
    { "id": "e2", "from": "api", "to": "db" }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 90,
    "sources": [{ "id": "s1", "node": "web", "shape": { "kind": "constant", "rps": 300 }, "readRatio": 0.7 }],
    "events": [
      { "atSec": 20, "event": { "kind": "replica-lag", "target": "db", "params": { "ms": 3000 }, "durationSec": 20 } },
      { "atSec": 55, "event": { "kind": "kill-leader", "target": "db" } }
    ]
  },
  "wire": {
    "host": "api.bank.io",
    "read": {
      "method": "GET",
      "path": "/api/accounts/{key}",
      "body": "{\"id\": {key}, \"balance\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/api/accounts/{key}/deposits",
      "reqBody": "{\"amount\": {value}}",
      "status": 201,
      "body": "{\"id\": {key}, \"status\": \"posted\"}"
    },
    "table": "accounts",
    "valCol": "balance"
  }
}
