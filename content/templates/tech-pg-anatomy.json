{
  "schemaVersion": 1,
  "id": "tech-pg-anatomy",
  "name": "Postgres: anatomy",
  "description": "App → PgBouncer (transaction pooling) → primary (backends, shared buffers, WAL, autovacuum, checkpointer) → streaming standby.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 40
      },
      "config": {}
    },
    {
      "id": "app",
      "type": "service",
      "name": "app",
      "pos": {
        "x": 195,
        "y": 150
      },
      "config": {
        "instances": 4,
        "slots": 64,
        "p50Ms": 1,
        "p99Ms": 3
      }
    },
    {
      "id": "bouncer",
      "type": "pgbouncer",
      "skin": "pgbouncer-std",
      "name": "PgBouncer",
      "pos": {
        "x": 195,
        "y": 260
      },
      "config": {}
    },
    {
      "id": "pg",
      "type": "pg-primary",
      "skin": "postgres-primary",
      "name": "primary",
      "pos": {
        "x": 195,
        "y": 380
      },
      "config": {
        "checkpointTimeoutSec": 15
      }
    },
    {
      "id": "standby",
      "type": "pg-replica",
      "skin": "postgres-standby",
      "name": "standby",
      "pos": {
        "x": 330,
        "y": 500
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "e-users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "e-app-bouncer",
      "from": "app",
      "to": "bouncer"
    },
    {
      "id": "e-bouncer-pg",
      "from": "bouncer",
      "to": "pg"
    },
    {
      "id": "e-pg-standby",
      "from": "pg",
      "to": "standby",
      "config": {
        "mode": "async"
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 180,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 400
        },
        "readRatio": 0.7
      }
    ],
    "events": []
  },
  "wire": {
    "host": "api.ledgerly.com",
    "read": {
      "path": "/v1/accounts/{key}/balance",
      "body": "{\"account_id\": {key}, \"balance_cents\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/transfers",
      "reqBody": "{\"from\": {key}, \"to\": 42, \"amount_cents\": {value}}",
      "status": 201,
      "body": "{\"transfer_id\": {key}, \"status\": \"posted\"}"
    },
    "table": "accounts",
    "valCol": "balance_cents"
  }
}
