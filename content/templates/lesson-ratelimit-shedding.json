{
  "schemaVersion": 1,
  "id": "lesson-ratelimit-shedding",
  "name": "Backpressure & load shedding",
  "description": "Same API twice, 3× overload. Left: an unbounded queue accepts everything, so every request waits seconds and times out. Right: the queue is capped at 40; excess gets a fast 503 and admitted requests keep a low p99.",
  "nodes": [
    {
      "id": "users-q",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 55,
        "y": 60
      }
    },
    {
      "id": "api-q",
      "type": "service",
      "name": "API · unbounded queue",
      "pos": {
        "x": 55,
        "y": 220
      },
      "config": {
        "instances": 2,
        "slots": 8,
        "p50Ms": 20,
        "p99Ms": 60,
        "queueLimit": 100000
      }
    },
    {
      "id": "users-s",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 305,
        "y": 60
      }
    },
    {
      "id": "api-s",
      "type": "service",
      "name": "API · queue ≤ 40",
      "pos": {
        "x": 305,
        "y": 220
      },
      "config": {
        "instances": 2,
        "slots": 8,
        "p50Ms": 20,
        "p99Ms": 60,
        "queueLimit": 40
      }
    }
  ],
  "edges": [
    {
      "id": "users-q->api-q",
      "from": "users-q",
      "to": "api-q",
      "config": {
        "timeoutMs": 5000
      }
    },
    {
      "id": "users-s->api-s",
      "from": "users-s",
      "to": "api-s",
      "config": {
        "timeoutMs": 5000
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 120,
    "sources": [
      {
        "id": "s1",
        "node": "users-q",
        "shape": {
          "kind": "constant",
          "rps": 400
        }
      },
      {
        "id": "s2",
        "node": "users-s",
        "shape": {
          "kind": "constant",
          "rps": 400
        }
      }
    ],
    "events": []
  },
  "wire": {
    "host": "tickets.example",
    "read": {
      "path": "/api/events/{key}/seats"
    },
    "write": {
      "method": "POST",
      "path": "/api/events/{key}/holds",
      "reqBody": "{\"seats\": 2}",
      "status": 201,
      "body": "{\"hold_id\": {key}, \"expires_in\": 300}"
    }
  }
}
