{
  "schemaVersion": 1,
  "id": "problem-ticket-booking-v1",
  "name": "Ticket booking: naive",
  "description": "The API reads remaining seats, checks, then writes, with nothing serialising concurrent buyers. Fine at 50 rps; a hot on-sale double-sells.",
  "nodes": [
    {"id":"users","type":"mobile-client","skin":"ios-app","name":"Fans","pos":{"x":0,"y":0}},
    {"id":"api","type":"service","skin":"node-service","name":"Booking API","pos":{"x":0,"y":110},"config":{"instances":2}},
    {"id":"inv","type":"inventory","skin":"ticket-inventory","name":"Seats","pos":{"x":0,"y":220},"config":{"mode":"naive","seatsPerKey":2000,"holdTtlMs":10000,"confirmMs":3000}}
  ],
  "edges": [
    {"id":"users-api","from":"users","to":"api","config":{"timeoutMs":5000}},
    {"id":"api-inv","from":"api","to":"inv","config":{"timeoutMs":3000}}
  ],
  "containers": [],
  "scenario": {"durationSec":60,"sources":[{"id":"fans","node":"users","shape":{"kind":"constant","rps":50},"readRatio":0.8,"keys":{"kind":"zipf","s":1.2,"keys":8}}],"events":[]},
  "wire": {
    "host": "api.tickets.example",
    "read": {
      "method": "GET",
      "path": "/v1/events/{key}/seats",
      "status": 200,
      "body": "{\"event_id\": {key}, \"available\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/events/{key}/holds",
      "reqBody": "{\"seats\": [\"A12\", \"A13\"]}",
      "status": 201,
      "body": "{\"hold_id\": \"{code}\", \"expires_in\": 300}"
    }
  }
}
