{
  "schemaVersion": 1,
  "id": "tech-kafka-batching",
  "name": "Kafka: batching side by side",
  "description": "Two producers, same traffic: A sends every record alone (linger.ms=0, batch 1); B waits 20ms and batches up to 200. Compare requests per second.",
  "nodes": [
    {
      "id": "users-1",
      "type": "web-client",
      "name": "Users A",
      "pos": {
        "x": 121,
        "y": 40
      }
    },
    {
      "id": "users-2",
      "type": "web-client",
      "name": "Users B",
      "pos": {
        "x": 325,
        "y": 40
      }
    },
    {
      "id": "pa",
      "type": "kafka-producer",
      "name": "producer A (no batching)",
      "pos": {
        "x": 121,
        "y": 150
      },
      "config": {
        "lingerMs": 0,
        "batchRecords": 1
      }
    },
    {
      "id": "pb",
      "type": "kafka-producer",
      "name": "producer B (linger 20ms)",
      "pos": {
        "x": 325,
        "y": 150
      },
      "config": {
        "lingerMs": 20,
        "batchRecords": 200
      }
    },
    {
      "id": "b1",
      "type": "kafka-broker",
      "name": "broker-1",
      "pos": {
        "x": 55,
        "y": 280
      }
    },
    {
      "id": "b2",
      "type": "kafka-broker",
      "name": "broker-2",
      "pos": {
        "x": 223,
        "y": 280
      }
    },
    {
      "id": "b3",
      "type": "kafka-broker",
      "name": "broker-3",
      "pos": {
        "x": 391,
        "y": 280
      }
    },
    {
      "id": "ctrl",
      "type": "kraft-controller",
      "name": "controller",
      "pos": {
        "x": 223,
        "y": 400
      }
    },
    {
      "id": "c1",
      "type": "kafka-consumer",
      "name": "consumer-1",
      "pos": {
        "x": 121,
        "y": 520
      },
      "config": {
        "group": "billing"
      }
    },
    {
      "id": "c2",
      "type": "kafka-consumer",
      "name": "consumer-2",
      "pos": {
        "x": 325,
        "y": 520
      },
      "config": {
        "group": "billing"
      }
    }
  ],
  "edges": [
    {
      "id": "users-1-pa",
      "from": "users-1",
      "to": "pa"
    },
    {
      "id": "users-2-pb",
      "from": "users-2",
      "to": "pb"
    },
    {
      "id": "pa-b1",
      "from": "pa",
      "to": "b1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "pb-b1",
      "from": "pb",
      "to": "b1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "pa-b2",
      "from": "pa",
      "to": "b2",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "pb-b2",
      "from": "pb",
      "to": "b2",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "pa-b3",
      "from": "pa",
      "to": "b3",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "pb-b3",
      "from": "pb",
      "to": "b3",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "ctrl-b1",
      "from": "ctrl",
      "to": "b1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "ctrl-b2",
      "from": "ctrl",
      "to": "b2",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "ctrl-b3",
      "from": "ctrl",
      "to": "b3",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b1-c1",
      "from": "b1",
      "to": "c1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b2-c1",
      "from": "b2",
      "to": "c1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b3-c1",
      "from": "b3",
      "to": "c1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b1-c2",
      "from": "b1",
      "to": "c2",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b2-c2",
      "from": "b2",
      "to": "c2",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b3-c2",
      "from": "b3",
      "to": "c2",
      "config": {
        "mode": "async"
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s1",
        "node": "users-1",
        "shape": {
          "kind": "constant",
          "rps": 2000
        },
        "readRatio": 0
      },
      {
        "id": "s2",
        "node": "users-2",
        "shape": {
          "kind": "constant",
          "rps": 2000
        },
        "readRatio": 0
      }
    ],
    "events": []
  },
  "wire": {
    "host": "metrics.example.com",
    "read": {
      "method": "GET",
      "path": "/api/hosts/{key}/cpu",
      "status": 200,
      "body": "{\"host_id\": {key}, \"cpu_pct\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/metrics",
      "reqBody": "{\"host_id\": {key}, \"cpu_pct\": {value}}",
      "status": 202,
      "body": "{\"accepted\": 1}"
    },
    "topic": "metrics"
  }
}
