{
  "schemaVersion": 1,
  "id": "tech-kafka-hot-partition",
  "name": "Kafka: hot partition",
  "description": "Keys are hashed to 6 partitions. When one key gets 60% of traffic its partition — one leader, one consumer — carries it alone.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 40
      }
    },
    {
      "id": "prod",
      "type": "kafka-producer",
      "name": "producer",
      "pos": {
        "x": 195,
        "y": 150
      }
    },
    {
      "id": "b1",
      "type": "kafka-broker",
      "name": "broker-1",
      "pos": {
        "x": 55,
        "y": 280
      }
    },
    {
      "id": "b2",
      "type": "kafka-broker",
      "name": "broker-2",
      "pos": {
        "x": 195,
        "y": 280
      }
    },
    {
      "id": "b3",
      "type": "kafka-broker",
      "name": "broker-3",
      "pos": {
        "x": 335,
        "y": 280
      }
    },
    {
      "id": "ctrl",
      "type": "kraft-controller",
      "name": "controller",
      "pos": {
        "x": 195,
        "y": 400
      }
    },
    {
      "id": "c1",
      "type": "kafka-consumer",
      "name": "consumer-1",
      "pos": {
        "x": 110,
        "y": 520
      },
      "config": {
        "group": "billing",
        "p50Ms": 0.4,
        "p99Ms": 1.5
      }
    },
    {
      "id": "c2",
      "type": "kafka-consumer",
      "name": "consumer-2",
      "pos": {
        "x": 280,
        "y": 520
      },
      "config": {
        "group": "billing",
        "p50Ms": 0.4,
        "p99Ms": 1.5
      }
    }
  ],
  "edges": [
    {
      "id": "users-prod",
      "from": "users",
      "to": "prod"
    },
    {
      "id": "prod-b1",
      "from": "prod",
      "to": "b1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "prod-b2",
      "from": "prod",
      "to": "b2",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "prod-b3",
      "from": "prod",
      "to": "b3",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "ctrl-b1",
      "from": "ctrl",
      "to": "b1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "ctrl-b2",
      "from": "ctrl",
      "to": "b2",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "ctrl-b3",
      "from": "ctrl",
      "to": "b3",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b1-c1",
      "from": "b1",
      "to": "c1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b2-c1",
      "from": "b2",
      "to": "c1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b3-c1",
      "from": "b3",
      "to": "c1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b1-c2",
      "from": "b1",
      "to": "c2",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b2-c2",
      "from": "b2",
      "to": "c2",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "b3-c2",
      "from": "b3",
      "to": "c2",
      "config": {
        "mode": "async"
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 3000
        },
        "readRatio": 0
      }
    ],
    "events": []
  },
  "wire": {
    "host": "chat.example.com",
    "read": {
      "method": "GET",
      "path": "/api/rooms/{key}/messages",
      "status": 200,
      "body": "{\"room_id\": {key}, \"latest\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/api/rooms/{key}/messages",
      "reqBody": "{\"text\": \"gg\", \"seq\": {value}}",
      "status": 202,
      "body": "{\"room_id\": {key}, \"offset\": {value}}"
    },
    "topic": "chat-messages"
  }
}
