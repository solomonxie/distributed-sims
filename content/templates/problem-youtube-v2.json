{
  "schemaVersion": 1,
  "id": "problem-youtube-v2",
  "name": "YouTube — reference",
  "description": "Segments served by a CDN with origin shield from S3; uploads land in S3 and a queue feeds a transcoder fleet.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "skin": "react-spa",
      "name": "Viewers & creators",
      "pos": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "cdn",
      "type": "cdn",
      "skin": "cloudfront",
      "name": "Video CDN",
      "pos": {
        "x": -100,
        "y": 110
      },
      "config": {
        "originShield": true,
        "cacheablePct": 98
      }
    },
    {
      "id": "segments",
      "type": "object-store",
      "skin": "s3",
      "name": "Segments (renditions)",
      "pos": {
        "x": -100,
        "y": 440
      }
    },
    {
      "id": "alb",
      "type": "load-balancer",
      "skin": "aws-alb",
      "name": "Load balancer",
      "pos": {
        "x": 100,
        "y": 110
      }
    },
    {
      "id": "upload",
      "type": "service",
      "skin": "go-service",
      "name": "Upload API",
      "pos": {
        "x": 100,
        "y": 220
      },
      "config": {
        "instances": 2
      }
    },
    {
      "id": "raw",
      "type": "object-store",
      "skin": "s3",
      "name": "Raw uploads",
      "pos": {
        "x": 30,
        "y": 330
      }
    },
    {
      "id": "jobs",
      "type": "queue",
      "skin": "sqs",
      "name": "Transcode jobs",
      "pos": {
        "x": 150,
        "y": 330
      },
      "config": {
        "visibilityMs": 60000,
        "ordering": "fifo"
      }
    },
    {
      "id": "transcoder",
      "type": "worker",
      "name": "Transcoders",
      "pos": {
        "x": 100,
        "y": 440
      },
      "config": {
        "instances": 8,
        "slots": 8,
        "p50Ms": 6000,
        "p99Ms": 15000
      }
    }
  ],
  "edges": [
    {
      "id": "users->cdn",
      "from": "users",
      "to": "cdn",
      "config": {
        "op": "read"
      }
    },
    {
      "id": "users->alb",
      "from": "users",
      "to": "alb",
      "config": {
        "op": "write"
      }
    },
    {
      "id": "cdn->segments",
      "from": "cdn",
      "to": "segments"
    },
    {
      "id": "alb->upload",
      "from": "alb",
      "to": "upload"
    },
    {
      "id": "upload->raw",
      "from": "upload",
      "to": "raw"
    },
    {
      "id": "upload->jobs",
      "from": "upload",
      "to": "jobs",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "jobs->transcoder",
      "from": "jobs",
      "to": "transcoder"
    },
    {
      "id": "transcoder->segments",
      "from": "transcoder",
      "to": "segments"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 60,
    "sources": [
      {
        "id": "watch",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 3000
        },
        "readRatio": 1
      },
      {
        "id": "upload",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 2
        },
        "readRatio": 0,
        "payloadBytes": 50000000
      }
    ],
    "events": []
  },
  "wire": {
    "host": "www.youtube.example",
    "read": {
      "method": "GET",
      "path": "/v1/videos/{code}",
      "status": 200,
      "body": "{\"id\": \"{code}\", \"title\": \"…\", \"hls\": \"/v/{code}/master.m3u8\"}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/uploads",
      "reqBody": "{\"title\": \"My trip\", \"size_bytes\": 104857600}",
      "status": 201,
      "body": "{\"video_id\": \"{code}\", \"upload_url\": \"https://upload.example/{code}\"}"
    },
    "topic": "transcode-jobs"
  }
}
