{
  "schemaVersion": 1,
  "id": "tech-dynamodb-txn",
  "name": "DynamoDB: transaction conflicts",
  "description": "30% of writes are TransactWriteItems touching an order and an inventory item.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 239,
        "y": 90
      },
      "config": {}
    },
    {
      "id": "router",
      "type": "dynamodb-router",
      "name": "request router",
      "pos": {
        "x": 239,
        "y": 200
      },
      "config": {
        "mode": "on-demand",
        "peakRcu": 3000,
        "peakWcu": 1000,
        "txnPct": 30
      }
    },
    {
      "id": "s1",
      "type": "dynamodb-storage",
      "name": "storage node 1",
      "pos": {
        "x": 70,
        "y": 330
      },
      "config": {}
    },
    {
      "id": "s2",
      "type": "dynamodb-storage",
      "name": "storage node 2",
      "pos": {
        "x": 239,
        "y": 330
      },
      "config": {}
    },
    {
      "id": "s3",
      "type": "dynamodb-storage",
      "name": "storage node 3",
      "pos": {
        "x": 408,
        "y": 330
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "e-users-router",
      "from": "users",
      "to": "router"
    },
    {
      "id": "e-router-s1",
      "from": "router",
      "to": "s1"
    },
    {
      "id": "e-router-s2",
      "from": "router",
      "to": "s2"
    },
    {
      "id": "e-router-s3",
      "from": "router",
      "to": "s3"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 120,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 1000
        },
        "readRatio": 0.5
      }
    ],
    "events": []
  },
  "wire": {
    "host": "shop.example.com",
    "read": {
      "method": "GET",
      "path": "/api/orders/{key}",
      "status": 200,
      "body": "{\"order_id\": {key}, \"qty\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/api/orders",
      "reqBody": "{\"sku_id\": {key}, \"qty\": {value}}",
      "status": 201,
      "body": "{\"order_id\": {key}, \"status\": \"reserved\"}"
    },
    "table": "orders",
    "valCol": "qty"
  }
}