{
  "schemaVersion": 1,
  "id": "tech-pg-vacuum",
  "name": "Postgres: MVCC and vacuum",
  "description": "Every UPDATE leaves a dead row version. Autovacuum removes the ones no open transaction can still see.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 40
      },
      "config": {}
    },
    {
      "id": "app",
      "type": "service",
      "name": "app",
      "pos": {
        "x": 195,
        "y": 170
      },
      "config": {
        "instances": 4,
        "slots": 64,
        "p50Ms": 1,
        "p99Ms": 3
      }
    },
    {
      "id": "pg",
      "type": "pg-primary",
      "skin": "postgres-primary",
      "name": "primary",
      "pos": {
        "x": 195,
        "y": 320
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "e-users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "e-app-pg",
      "from": "app",
      "to": "pg"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 180,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 800
        },
        "readRatio": 0.5
      }
    ],
    "events": []
  },
  "wire": {
    "host": "api.stockroom.io",
    "read": {
      "path": "/v1/skus/{key}/stock",
      "body": "{\"sku_id\": {key}, \"qty\": {value}}"
    },
    "write": {
      "method": "PUT",
      "path": "/v1/skus/{key}/stock",
      "reqBody": "{\"qty\": {value}}",
      "status": 200,
      "body": "{\"sku_id\": {key}, \"qty\": {value}}"
    },
    "table": "stock",
    "valCol": "qty"
  }
}
