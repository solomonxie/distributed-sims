{
  "schemaVersion": 1,
  "id": "lesson-txn-2pc-blocking",
  "name": "Lesson: 2PC blocking",
  "description": "Same 2PC checkout. The coordinator can crash right after participants voted yes: they hold row locks and can't decide alone.",
  "nodes": [
    {
      "id": "web",
      "type": "web-client",
      "name": "Checkout",
      "pos": {
        "x": 195,
        "y": 60
      }
    },
    {
      "id": "tm",
      "type": "txn-coordinator",
      "skin": "2pc-coordinator",
      "name": "Coordinator",
      "pos": {
        "x": 195,
        "y": 200
      }
    },
    {
      "id": "orders",
      "type": "relational-db",
      "skin": "postgres",
      "name": "Orders DB",
      "pos": {
        "x": 55,
        "y": 340
      }
    },
    {
      "id": "payments",
      "type": "relational-db",
      "skin": "postgres",
      "name": "Payments DB",
      "pos": {
        "x": 195,
        "y": 340
      }
    },
    {
      "id": "stock",
      "type": "relational-db",
      "skin": "postgres",
      "name": "Stock DB",
      "pos": {
        "x": 335,
        "y": 340
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "web",
      "to": "tm",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "e2",
      "from": "tm",
      "to": "orders"
    },
    {
      "id": "e3",
      "from": "tm",
      "to": "payments"
    },
    {
      "id": "e4",
      "from": "tm",
      "to": "stock"
    }
  ],
  "containers": [],
  "alerts": [
    {
      "id": "a1",
      "target": "orders",
      "metric": "lockedKeys",
      "op": ">",
      "threshold": 0,
      "forSec": 3
    }
  ],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s1",
        "node": "web",
        "shape": {
          "kind": "constant",
          "rps": 30
        },
        "readRatio": 0
      }
    ],
    "events": []
  },
  "wire": {
    "host": "shop.example",
    "read": {
      "path": "/api/orders/{key}"
    },
    "write": {
      "method": "POST",
      "path": "/api/checkout",
      "reqBody": "{\"cart_id\": {key}, \"card\": \"tok_visa\"}",
      "status": 201,
      "body": "{\"order_id\": {key}, \"status\": \"committed\"}"
    },
    "table": "orders",
    "valCol": "status"
  }
}