{
  "schemaVersion": 1,
  "id": "lesson-consensus-raft",
  "name": "Lesson: Raft, 5 etcd members",
  "description": "A config API writes and reads through 5 etcd members, 3 in Zone A and 2 in Zone B. Requests to a follower are forwarded to the \ud83d\udc51 leader. Open the sequence view to see RequestVote and AppendEntries. Zone B members use longer election timeouts, so the leader starts in Zone A.",
  "nodes": [
    {
      "id": "web",
      "type": "web-client",
      "name": "Clients",
      "pos": {
        "x": 195,
        "y": 40
      }
    },
    {
      "id": "api",
      "type": "service",
      "name": "Config API",
      "pos": {
        "x": 195,
        "y": 170
      },
      "config": {
        "fanout": "one"
      }
    },
    {
      "id": "etcd-1",
      "type": "consensus-member",
      "skin": "etcd",
      "name": "etcd-1",
      "parent": "az-a",
      "pos": {
        "x": 55,
        "y": 320
      }
    },
    {
      "id": "etcd-2",
      "type": "consensus-member",
      "skin": "etcd",
      "name": "etcd-2",
      "parent": "az-a",
      "pos": {
        "x": 195,
        "y": 320
      }
    },
    {
      "id": "etcd-3",
      "type": "consensus-member",
      "skin": "etcd",
      "name": "etcd-3",
      "parent": "az-a",
      "pos": {
        "x": 335,
        "y": 320
      }
    },
    {
      "id": "etcd-4",
      "type": "consensus-member",
      "skin": "etcd",
      "name": "etcd-4",
      "parent": "az-b",
      "pos": {
        "x": 125,
        "y": 480
      },
      "config": {
        "electionMinMs": 2000,
        "electionMaxMs": 3000
      }
    },
    {
      "id": "etcd-5",
      "type": "consensus-member",
      "skin": "etcd",
      "name": "etcd-5",
      "parent": "az-b",
      "pos": {
        "x": 265,
        "y": 480
      },
      "config": {
        "electionMinMs": 2000,
        "electionMaxMs": 3000
      }
    }
  ],
  "edges": [
    {
      "id": "e0",
      "from": "web",
      "to": "api",
      "config": {
        "timeoutMs": 5000
      }
    },
    {
      "id": "e1",
      "from": "api",
      "to": "etcd-1",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "e2",
      "from": "api",
      "to": "etcd-2",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "e3",
      "from": "api",
      "to": "etcd-3",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "e4",
      "from": "api",
      "to": "etcd-4",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "e5",
      "from": "api",
      "to": "etcd-5",
      "config": {
        "timeoutMs": 3000
      }
    }
  ],
  "containers": [
    {
      "id": "az-a",
      "kind": "availability-zone",
      "name": "Zone A",
      "config": {
        "zone": "a"
      }
    },
    {
      "id": "az-b",
      "kind": "availability-zone",
      "name": "Zone B",
      "config": {
        "zone": "b"
      }
    }
  ],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s1",
        "node": "web",
        "shape": {
          "kind": "constant",
          "rps": 100
        },
        "readRatio": 0.5
      }
    ],
    "events": []
  },
  "wire": {
    "host": "config.internal",
    "read": {
      "path": "/v3/kv/{key}",
      "body": "{\"key\": {key}, \"value\": {value}, \"revision\": 7}"
    },
    "write": {
      "method": "PUT",
      "path": "/v3/kv/{key}",
      "reqBody": "{\"value\": \"{value}\"}",
      "status": 200,
      "body": "{\"key\": {key}, \"revision\": 1}"
    }
  }
}