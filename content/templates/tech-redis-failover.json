{
  "schemaVersion": 1,
  "id": "tech-redis-failover",
  "name": "Redis: async replica, lost writes",
  "description": "Replication is asynchronous: the primary acks before the replica has the write. If the primary dies, Sentinel promotes the replica — minus whatever it had not received.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 40
      }
    },
    {
      "id": "app",
      "type": "service",
      "name": "app",
      "pos": {
        "x": 195,
        "y": 160
      },
      "config": {
        "instances": 4,
        "slots": 256,
        "p50Ms": 0.2,
        "p99Ms": 1
      }
    },
    {
      "id": "redis",
      "type": "redis-server",
      "name": "redis primary",
      "pos": {
        "x": 110,
        "y": 290
      },
      "skin": "redis-internals"
    },
    {
      "id": "replica",
      "type": "redis-server",
      "name": "redis replica",
      "pos": {
        "x": 280,
        "y": 290
      },
      "skin": "redis-internals",
      "config": {
        "role": "replica"
      }
    }
  ],
  "edges": [
    {
      "id": "users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "app-redis",
      "from": "app",
      "to": "redis",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "redis-replica",
      "from": "redis",
      "to": "replica",
      "config": {
        "mode": "async"
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 20000
        },
        "readRatio": 0.5
      }
    ],
    "events": []
  },
  "wire": {
    "host": "api.pageviews.io",
    "read": {
      "path": "/v1/pages/{key}/views",
      "body": "{\"page_id\": {key}, \"views\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/pages/{key}/hit",
      "reqBody": "{\"ref\": \"twitter\"}",
      "status": 200,
      "body": "{\"views\": {value}}"
    },
    "cachePrefix": "views:"
  }
}
