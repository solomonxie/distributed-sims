{
  "schemaVersion": 1,
  "id": "tech-rediscluster-split",
  "name": "Redis Cluster: minority primary",
  "description": "rc-1 and rc-5 sit in AZ a; everything else in AZ b. Split the AZs: rc-1 keeps taking writes for a while, but the majority fails it over to rc-4.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "skin": "react-spa",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 30
      },
      "config": {}
    },
    {
      "id": "app",
      "type": "redis-cluster-client",
      "skin": "redis-cluster-lettuce",
      "name": "app (cluster client)",
      "pos": {
        "x": 195,
        "y": 130
      },
      "config": {}
    },
    {
      "id": "rc1",
      "type": "redis-cluster-node",
      "skin": "redis-cluster-primary",
      "name": "rc-1",
      "pos": {
        "x": 55,
        "y": 260
      },
      "config": {
        "slotRange": "0-5460"
      },
      "parent": "az-a"
    },
    {
      "id": "rc2",
      "type": "redis-cluster-node",
      "skin": "redis-cluster-primary",
      "name": "rc-2",
      "pos": {
        "x": 195,
        "y": 260
      },
      "config": {
        "slotRange": "5461-10922"
      },
      "parent": "az-b"
    },
    {
      "id": "rc3",
      "type": "redis-cluster-node",
      "skin": "redis-cluster-primary",
      "name": "rc-3",
      "pos": {
        "x": 335,
        "y": 260
      },
      "config": {
        "slotRange": "10923-16383"
      },
      "parent": "az-b"
    },
    {
      "id": "rc4",
      "type": "redis-cluster-node",
      "skin": "redis-cluster-replica",
      "name": "rc-4",
      "pos": {
        "x": 55,
        "y": 380
      },
      "config": {
        "replicaOf": "rc1"
      },
      "parent": "az-b"
    },
    {
      "id": "rc5",
      "type": "redis-cluster-node",
      "skin": "redis-cluster-replica",
      "name": "rc-5",
      "pos": {
        "x": 195,
        "y": 380
      },
      "config": {
        "replicaOf": "rc2"
      },
      "parent": "az-a"
    },
    {
      "id": "rc6",
      "type": "redis-cluster-node",
      "skin": "redis-cluster-replica",
      "name": "rc-6",
      "pos": {
        "x": 335,
        "y": 380
      },
      "config": {
        "replicaOf": "rc3"
      },
      "parent": "az-b"
    }
  ],
  "edges": [
    {
      "id": "e-users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "e-app-rc1",
      "from": "app",
      "to": "rc1"
    },
    {
      "id": "e-app-rc2",
      "from": "app",
      "to": "rc2"
    },
    {
      "id": "e-app-rc3",
      "from": "app",
      "to": "rc3"
    },
    {
      "id": "e-rc1-rc4",
      "from": "rc1",
      "to": "rc4",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "e-rc2-rc5",
      "from": "rc2",
      "to": "rc5",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "e-rc3-rc6",
      "from": "rc3",
      "to": "rc6",
      "config": {
        "mode": "async"
      }
    }
  ],
  "containers": [
    {
      "id": "az-a",
      "kind": "availability-zone",
      "name": "AZ a"
    },
    {
      "id": "az-b",
      "kind": "availability-zone",
      "name": "AZ b"
    }
  ],
  "scenario": {
    "durationSec": 120,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 1000
        },
        "readRatio": 0.7
      }
    ],
    "events": []
  },
  "wire": {
    "host": "api.payfast.io",
    "read": {
      "path": "/v1/payments/{key}",
      "body": "{\"payment_id\": {key}, \"status\": \"succeeded\"}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/payments",
      "reqBody": "{\"amount_cents\": {value}, \"idempotency_key\": \"{code}\"}",
      "status": 201,
      "body": "{\"payment_id\": {key}}"
    },
    "cachePrefix": "idem:"
  }
}
