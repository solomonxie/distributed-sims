    "read": {
      "path": "/api/v1/applications/app-{key}/executors",
      "body": "[{\"id\": \"2\", \"isActive\": false, \"failedTasks\": 4}]"
    },
    "write": {
      "method": "POST",
      "path": "/v1/submissions/create",
      "reqBody": "{\"mainClass\": \"logs.Compact\", \"appArgs\": [\"--day\", \"2026-09-26\"]}",
