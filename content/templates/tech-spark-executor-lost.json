      "pos": {
        "x": 223,
        "y": 220
      },
      "config": {}
    },
    {
      "id": "exec-3",
      "type": "spark-executor",
      "skin": "spark-executor-std",
      "name": "Executor 3",
      "pos": {
        "x": 391,
        "y": 220
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "d-e1",
