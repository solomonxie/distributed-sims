{
  "schemaVersion": 1,
  "id": "problem-send-email-v2",
  "name": "Send email: queue + idempotent workers",
  "description": "The API records the send and enqueues it; a FIFO queue keyed by recipient feeds workers that ack late and dedupe by message id, so a provider outage only grows the backlog. Nothing is lost and nothing is sent twice.",
  "nodes": [
    {"id":"users","type":"web-client","skin":"react-spa","name":"Users","pos":{"x":0,"y":0}},
    {"id":"api","type":"service","skin":"node-service","name":"Notify API","pos":{"x":0,"y":110},"config":{"instances":2}},
    {"id":"db","type":"relational-db","skin":"postgres","name":"Notifications DB","pos":{"x":-80,"y":220}},
    {"id":"sqs","type":"queue","skin":"sqs","name":"Send queue","pos":{"x":80,"y":220},"config":{"ordering":"fifo","visibilityMs":5000,"maxReceives":100}},
    {"id":"workers","type":"worker","skin":"celery-worker","name":"Mail workers","pos":{"x":80,"y":330},"config":{"instances":4,"ackMode":"late","idempotent":true}},
    {"id":"sendgrid","type":"external-api","skin":"sendgrid","name":"SendGrid","pos":{"x":80,"y":440}}
  ],
  "edges": [
    {"id":"users-api","from":"users","to":"api","config":{"timeoutMs":5000}},
    {"id":"api-db","from":"api","to":"db"},
    {"id":"api-sqs","from":"api","to":"sqs"},
    {"id":"sqs-workers","from":"sqs","to":"workers"},
    {"id":"workers-sendgrid","from":"workers","to":"sendgrid","config":{"timeoutMs":2000}}
  ],
  "containers": [],
  "scenario": {"durationSec":60,"sources":[{"id":"sends","node":"users","shape":{"kind":"constant","rps":200},"readRatio":0}],"events":[]},
  "wire": {
    "host": "api.mailer.example",
    "read": {
      "method": "GET",
      "path": "/v1/messages/{key}",
      "status": 200,
      "body": "{\"id\": {key}, \"status\": \"delivered\", \"provider\": \"sendgrid\"}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/messages",
      "reqBody": "{\"to\": \"user{key}@example.com\", \"template\": \"welcome\"}",
      "status": 202,
      "body": "{\"id\": {key}, \"status\": \"queued\"}"
    },
    "table": "email_sends",
    "valCol": "status",
    "topic": "email-sends"
  }
}
