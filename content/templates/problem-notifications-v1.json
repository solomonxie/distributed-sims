{
  "schemaVersion": 1,
  "id": "problem-notifications-v1",
  "name": "Notification system — naive",
  "description": "The notification API calls APNs, Twilio and SendGrid inline, one after another, before answering.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Product services",
      "pos": {
        "x": 48,
        "y": 0
      }
    },
    {
      "id": "api",
      "type": "service",
      "skin": "go-service",
      "name": "Notification API",
      "pos": {
        "x": 48,
        "y": 110
      },
      "config": {
        "instances": 2
      }
    },
    {
      "id": "log",
      "type": "relational-db",
      "skin": "postgres",
      "name": "Notification log",
      "pos": {
        "x": 216,
        "y": 110
      }
    },
    {
      "id": "apns",
      "type": "external-api",
      "skin": "apns",
      "name": "APNs",
      "pos": {
        "x": -120,
        "y": 220
      }
    },
    {
      "id": "twilio",
      "type": "external-api",
      "skin": "twilio",
      "name": "Twilio SMS",
      "pos": {
        "x": 48,
        "y": 220
      }
    },
    {
      "id": "sendgrid",
      "type": "external-api",
      "skin": "sendgrid",
      "name": "SendGrid",
      "pos": {
        "x": 216,
        "y": 220
      }
    }
  ],
  "edges": [
    {
      "id": "users->api",
      "from": "users",
      "to": "api"
    },
    {
      "id": "api->log",
      "from": "api",
      "to": "log"
    },
    {
      "id": "api->apns",
      "from": "api",
      "to": "apns",
      "config": {
        "ratio": 0.7
      }
    },
    {
      "id": "api->twilio",
      "from": "api",
      "to": "twilio",
      "config": {
        "ratio": 0.1
      }
    },
    {
      "id": "api->sendgrid",
      "from": "api",
      "to": "sendgrid",
      "config": {
        "ratio": 0.4
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 60,
    "sources": [
      {
        "id": "events",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 500
        },
        "readRatio": 0
      }
    ],
    "events": []
  },
  "wire": {
    "host": "notify.internal",
    "read": {
      "method": "GET",
      "path": "/v1/notifications/{key}",
      "status": 200,
      "body": "{\"id\": {key}, \"channel\": \"push\", \"status\": \"delivered\"}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/notifications",
      "reqBody": "{\"user_id\": {key}, \"channel\": \"push\", \"template\": \"order_shipped\"}",
      "status": 202,
      "body": "{\"id\": {key}, \"status\": \"queued\"}"
    },
    "table": "notification_log",
    "valCol": "status"
  }
}
