{
  "schemaVersion": 1,
  "id": "tech-redis-bgsave",
  "name": "Redis: fork() and copy-on-write",
  "description": "50 GB dataset, write-heavy. BGSAVE forks: copying page tables stalls the loop, then each write to a shared page copies it.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 40
      }
    },
    {
      "id": "app",
      "type": "service",
      "name": "app",
      "pos": {
        "x": 195,
        "y": 160
      },
      "config": {
        "instances": 4,
        "slots": 256,
        "p50Ms": 0.2,
        "p99Ms": 1
      }
    },
    {
      "id": "redis",
      "type": "redis-server",
      "name": "redis primary",
      "pos": {
        "x": 195,
        "y": 290
      },
      "skin": "redis-internals",
      "config": {
        "datasetGb": 50
      }
    }
  ],
  "edges": [
    {
      "id": "users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "app-redis",
      "from": "app",
      "to": "redis",
      "config": {
        "timeoutMs": 3000
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 20000
        },
        "readRatio": 0.5
      }
    ],
    "events": []
  },
  "wire": {
    "host": "shop.greenbasket.com",
    "read": {
      "path": "/api/cart",
      "body": "{\"cart\": \"{code}\", \"items\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/api/cart/items",
      "reqBody": "{\"product_id\": {key}, \"qty\": {value}}",
      "status": 201,
      "body": "{\"cart\": \"{code}\", \"items\": 4}"
    },
    "cachePrefix": "cart:"
  }
}
