{
  "schemaVersion": 1,
  "id": "problem-autocomplete-v2",
  "name": "Autocomplete — reference",
  "description": "Short prefixes cached at the edge; the rest served from precomputed top-K tries in Redis; query logs rebuild the tries offline.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "skin": "react-spa",
      "name": "Typing users",
      "pos": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "cdn",
      "type": "cdn",
      "skin": "cloudflare-cdn",
      "name": "Edge cache (short prefixes)",
      "pos": {
        "x": 0,
        "y": 110
      },
      "config": {
        "cacheablePct": 60,
        "ttlSec": 600,
        "p99Ms": 4
      }
    },
    {
      "id": "alb",
      "type": "load-balancer",
      "skin": "aws-nlb",
      "name": "Load balancer",
      "pos": {
        "x": 0,
        "y": 220
      }
    },
    {
      "id": "api",
      "type": "service",
      "skin": "go-service",
      "name": "Suggest API",
      "pos": {
        "x": 0,
        "y": 330
      },
      "config": {
        "instances": 3,
        "p50Ms": 1,
        "p99Ms": 4
      }
    },
    {
      "id": "tries",
      "type": "cache",
      "skin": "elasticache",
      "name": "Top-K trie shards",
      "pos": {
        "x": -100,
        "y": 440
      },
      "config": {
        "capacityKeys": 1024,
        "ttlSec": 86400
      }
    },
    {
      "id": "logs",
      "type": "log-stream",
      "skin": "kafka",
      "name": "Query log",
      "pos": {
        "x": 100,
        "y": 440
      }
    },
    {
      "id": "builder",
      "type": "worker",
      "name": "Trie builder",
      "pos": {
        "x": 100,
        "y": 550
      },
      "config": {
        "instances": 2,
        "slots": 16,
        "p50Ms": 5,
        "p99Ms": 20,
        "idempotent": true
      }
    }
  ],
  "edges": [
    {
      "id": "users->cdn",
      "from": "users",
      "to": "cdn",
      "config": {
        "latencyMs": 4
      }
    },
    {
      "id": "cdn->alb",
      "from": "cdn",
      "to": "alb"
    },
    {
      "id": "alb->api",
      "from": "alb",
      "to": "api"
    },
    {
      "id": "api->tries",
      "from": "api",
      "to": "tries",
      "config": {
        "op": "read"
      }
    },
    {
      "id": "api->logs",
      "from": "api",
      "to": "logs",
      "config": {
        "mode": "async",
        "op": "write"
      }
    },
    {
      "id": "logs->builder",
      "from": "logs",
      "to": "builder"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 60,
    "sources": [
      {
        "id": "typing",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 3000
        },
        "readRatio": 0.98
      }
    ],
    "events": []
  },
  "wire": {
    "host": "complete.example.com",
    "read": {
      "method": "GET",
      "path": "/v1/suggest?q=q{key}&n=10",
      "status": 200,
      "body": "{\"q\": \"q{key}\", \"suggestions\": [\"q{key}0\", \"q{key}1\", \"q{key}2\"]}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/queries",
      "reqBody": "{\"q\": \"q{key}\", \"ts\": 1767225600}",
      "status": 202,
      "body": "{\"logged\": true}"
    },
    "cachePrefix": "topk:",
    "topic": "query-log"
  }
}
