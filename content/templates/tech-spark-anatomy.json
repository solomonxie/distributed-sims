  "wire": {
    "host": "spark-master.internal:6066",
    "read": {
      "path": "/api/v1/applications/app-{key}/stages",
      "body": "[{\"stageId\": 2, \"status\": \"ACTIVE\", \"numTasks\": 12}]"
    },
    "write": {
      "method": "POST",
      "path": "/v1/submissions/create",
      "reqBody": "{\"mainClass\": \"etl.DailySales\", \"appArgs\": [\"2026-09-27\"]}",
      "status": 200,
      "body": "{\"submissionId\": \"driver-{key}\", \"success\": true}"
    },
    "table": "daily_sales",
    "valCol": "revenue"
  }
