        "y": 60
      },
      "config": {
        "cronSec": 12
      }
    },
    {
      "id": "exec-1",
      "type": "spark-executor",
      "skin": "spark-executor-std",
      "name": "Executor 1",
      "pos": {
        "x": 55,
        "y": 220
      },
      "config": {}
    },
    {
      "id": "exec-2",
      "type": "spark-executor",
      "skin": "spark-executor-std",
      "name": "Executor 2",
      "pos": {
        "x": 223,
        "y": 220
      },
      "config": {}
    },
    {
      "id": "exec-3",
      "type": "spark-executor",
      "skin": "spark-executor-std",
      "name": "Executor 3",
      "pos": {
        "x": 391,
        "y": 220
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "d-e1",
      "from": "driver",
      "to": "exec-1"
    },
    {
      "id": "d-e2",
      "from": "driver",
      "to": "exec-2"
    },
    {
      "id": "d-e3",
      "from": "driver",
      "to": "exec-3"
    }
