{
  "schemaVersion": 1,
  "id": "tech-spark-anatomy",
  "name": "Spark: driver, executors, stages",
  "description": "A driver splits each job into stages at shuffle boundaries and runs one task per partition on 3 executors × 4 cores. A cron submits a job every 12s.",
