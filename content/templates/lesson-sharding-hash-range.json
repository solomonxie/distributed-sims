{
  "schemaVersion": 1,
  "id": "lesson-sharding-hash-range",
  "name": "Lesson: hash vs range sharding",
  "description": "Same auto-increment inserts, two shard maps. Left vtgate routes by key range, so every new id lands on the last range. Right vtgate hashes the id and spreads them.",
  "nodes": [
    {
      "id": "web",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 440,
        "y": 60
      }
    },
    {
      "id": "range",
      "type": "shard-router",
      "skin": "vitess",
      "name": "vtgate (range)",
      "pos": {
        "x": 188,
        "y": 190
      },
      "config": {
        "shardBy": "range",
        "keyPattern": "sequential"
      }
    },
    {
      "id": "hash",
      "type": "shard-router",
      "skin": "vitess",
      "name": "vtgate (hash)",
      "pos": {
        "x": 692,
        "y": 190
      },
      "config": {
        "shardBy": "hash",
        "keyPattern": "sequential"
      }
    },
    {
      "id": "r1",
      "type": "relational-db",
      "skin": "mysql",
      "name": "Range 1",
      "pos": {
        "x": 20,
        "y": 330
      },
      "config": {
        "replicas": 0,
        "slots": 2, "writeP50Ms": 5, "writeP99Ms": 20
      }
    },
    {
