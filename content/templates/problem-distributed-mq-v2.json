{
  "schemaVersion": 1,
  "id": "problem-distributed-mq-v2",
  "name": "Distributed MQ — reference",
  "description": "Three brokers, replication factor 3, acks=all (ISR), producer retries; consumers commit after processing and dedupe by message id.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Producers",
      "pos": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "api",
      "type": "service",
      "skin": "go-service",
      "name": "Orders API",
      "pos": {
        "x": 0,
        "y": 110
      },
      "config": {
        "instances": 2
      }
    },
    {
      "id": "broker",
      "type": "log-stream",
      "skin": "kafka",
      "name": "Brokers ×3 (RF=3, acks=all)",
      "pos": {
        "x": 0,
        "y": 220
      },
      "config": {
        "instances": 3,
        "acks": "all"
      }
    },
    {
      "id": "consumer-a",
      "type": "worker",
      "name": "Consumer A",
      "pos": {
        "x": -90,
        "y": 330
      },
      "config": {
        "group": "orders",
        "instances": 2,
        "slots": 32,
        "p50Ms": 2,
        "p99Ms": 10,
        "ackMode": "late",
        "idempotent": true
      }
    },
    {
      "id": "consumer-b",
      "type": "worker",
      "name": "Consumer B",
      "pos": {
        "x": 90,
        "y": 330
      },
      "config": {
        "group": "orders",
        "instances": 2,
        "slots": 32,
        "p50Ms": 2,
        "p99Ms": 10,
        "ackMode": "late",
        "idempotent": true
      }
    },
    {
      "id": "db",
      "type": "relational-db",
      "skin": "postgres",
      "name": "Orders DB",
      "pos": {
        "x": 0,
        "y": 440
      }
    }
  ],
  "edges": [
    {
      "id": "users->api",
      "from": "users",
      "to": "api"
    },
    {
      "id": "api->broker",
      "from": "api",
      "to": "broker",
      "config": {
        "retries": 3,
        "backoffMs": 500
      }
    },
    {
      "id": "broker->consumer-a",
      "from": "broker",
      "to": "consumer-a"
    },
    {
      "id": "broker->consumer-b",
      "from": "broker",
      "to": "consumer-b"
    },
    {
      "id": "consumer-a->db",
      "from": "consumer-a",
      "to": "db"
    },
    {
      "id": "consumer-b->db",
      "from": "consumer-b",
      "to": "db"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 60,
    "sources": [
      {
        "id": "producers",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 1000
        },
        "readRatio": 0
      }
    ],
    "events": []
  },
  "wire": {
    "host": "mq.internal",
    "read": {
      "method": "GET",
      "path": "/v1/topics/orders/messages?offset={key}",
      "status": 200,
      "body": "{\"offset\": {key}, \"key\": \"order-{key}\", \"value\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/topics/orders/messages",
      "reqBody": "{\"key\": \"order-{key}\", \"value\": {value}}",
      "status": 202,
      "body": "{\"partition\": 0, \"offset\": {key}}"
    },
    "table": "processed_messages",
    "valCol": "payload",
    "topic": "orders"
  }
}
