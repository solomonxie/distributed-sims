{
  "schemaVersion": 1,
  "id": "tech-pg-replica",
  "name": "Postgres: streaming replication lag",
  "description": "Writes go to the primary, reads to a hot standby that replays WAL in one thread at 1k writes/s.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 40
      },
      "config": {}
    },
    {
      "id": "app",
      "type": "service",
      "name": "app",
      "pos": {
        "x": 195,
        "y": 160
      },
      "config": {
        "instances": 4,
        "slots": 64,
        "p50Ms": 1,
        "p99Ms": 3
      }
    },
    {
      "id": "pg",
      "type": "pg-primary",
      "skin": "postgres-primary",
      "name": "primary",
      "pos": {
        "x": 100,
        "y": 320
      },
      "config": {}
    },
    {
      "id": "standby",
      "type": "pg-replica",
      "skin": "postgres-standby",
      "name": "standby",
      "pos": {
        "x": 290,
        "y": 320
      },
      "config": {
        "replayPerSec": 1000
      }
    }
  ],
  "edges": [
    {
      "id": "e-users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "e-app-pg",
      "from": "app",
      "to": "pg",
      "config": {
        "op": "write"
      }
    },
    {
      "id": "e-app-standby",
      "from": "app",
      "to": "standby",
      "config": {
        "op": "read"
      }
    },
    {
      "id": "e-pg-standby",
      "from": "pg",
      "to": "standby",
      "config": {
        "mode": "async"
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 180,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 1000
        },
        "readRatio": 0.6
      }
    ],
    "events": []
  },
  "wire": {
    "host": "api.chirp.social",
    "read": {
      "path": "/v1/users/{key}",
      "body": "{\"id\": {key}, \"handle\": \"@user{key}\", \"followers\": {value}}"
    },
    "write": {
      "method": "PATCH",
      "path": "/v1/users/{key}",
      "reqBody": "{\"followers\": {value}}",
      "status": 200,
      "body": "{\"id\": {key}, \"updated\": true}"
    },
    "table": "profiles",
    "valCol": "followers"
  }
}
