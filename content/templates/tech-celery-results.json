{
  "schemaVersion": 1,
  "id": "tech-celery-results",
  "name": "Celery: result backend fills up",
  "description": "Every task stores a 32 KB result that expires after a day, in a 4 MB Redis. Nobody reads them, so it fills.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 40
      }
    },
    {
      "id": "app",
      "type": "celery-producer",
      "skin": "celery-app",
      "name": "app (.delay)",
      "pos": {
        "x": 195,
        "y": 150
      },
      "config": {
        "taskMs": 300,
        "taskP99Ms": 800
      }
    },
    {
      "id": "broker",
      "type": "celery-broker",
      "skin": "celery-redis-broker",
      "name": "broker",
      "pos": {
        "x": 195,
        "y": 280
      },
      "config": {}
    },
    {
      "id": "w1",
      "type": "celery-worker",
      "skin": "celery-prefork",
      "name": "worker-1",
      "pos": {
        "x": 100,
        "y": 410
      },
      "config": {}
    },
    {
      "id": "w2",
      "type": "celery-worker",
      "skin": "celery-prefork",
      "name": "worker-2",
      "pos": {
        "x": 290,
        "y": 410
      },
      "config": {}
    },
    {
      "id": "results",
      "type": "celery-result-backend",
      "skin": "celery-redis-results",
      "name": "result backend",
      "pos": {
        "x": 195,
        "y": 540
      },
      "config": {
        "maxMemoryMb": 4,
        "resultKb": 32
      }
    }
  ],
  "edges": [
    {
      "id": "e-users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "e-app-broker",
      "from": "app",
      "to": "broker"
    },
    {
      "id": "e-broker-w1",
      "from": "broker",
      "to": "w1",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "e-broker-w2",
      "from": "broker",
      "to": "w2",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "e-w1-results",
      "from": "w1",
      "to": "results"
    },
    {
      "id": "e-w2-results",
      "from": "w2",
      "to": "results"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 120,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 5
        },
        "readRatio": 0
      }
    ],
    "events": []
  },
  "wire": {
    "host": "billing.example.com",
    "read": {
      "method": "GET",
      "path": "/api/tasks/{code}/result",
      "status": 200,
      "body": "{\"task_id\": \"{code}\", \"status\": \"SUCCESS\"}"
    },
    "write": {
      "method": "POST",
      "path": "/api/invoices/{key}/pdf",
      "reqBody": "{\"template\": \"default\", \"lines\": {value}}",
      "status": 202,
      "body": "{\"task_id\": \"{code}\", \"status\": \"PENDING\"}"
    },
    "topic": "invoices"
  }
}
