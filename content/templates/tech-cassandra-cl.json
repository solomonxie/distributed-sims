  "wire": {
    "host": "iot.example.com",
    "read": {
      "method": "GET",
      "path": "/api/sensors/{key}/latest",
      "status": 200,
      "body": "{\"sensor_id\": {key}, \"temp_c\": {value}}"
    },
    "write": {
      "method": "POST",
      "path": "/api/sensors/{key}/readings",
      "reqBody": "{\"temp_c\": {value}}",
      "status": 201,
      "body": "{\"sensor_id\": {key}, \"accepted\": true}"
    },
    "table": "sensor_readings",
    "valCol": "temp_c"
  }
