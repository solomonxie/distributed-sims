{
  "schemaVersion": 1,
  "id": "problem-kv-store-v2",
  "name": "KV store: quorum + hinted handoff",
  "description": "Same ring, but R=2 W=2 over N=3 (R+W>N) so every read overlaps the last acked write; hinted handoff and read repair heal replicas, and clients retry another coordinator.",
  "nodes": [
    {"id":"users","type":"web-client","name":"Clients","pos":{"x":0,"y":0}},
    {"id":"api","type":"service","skin":"go-service","name":"KV API","pos":{"x":0,"y":110},"config":{"instances":2}},
    {"id":"kv","type":"kv-store","skin":"riak","name":"KV cluster","pos":{"x":0,"y":220},"config":{"members":5,"replicationFactor":3,"readConsistency":"quorum","writeConsistency":"quorum","hintedHandoff":true,"sloppyQuorum":false,"readRepair":true}}
  ],
  "edges": [
    {"id":"users-api","from":"users","to":"api","config":{"timeoutMs":3000}},
    {"id":"api-kv","from":"api","to":"kv","config":{"timeoutMs":500,"retries":4,"backoffMs":5}}
  ],
  "containers": [],
  "scenario": {"durationSec":60,"sources":[{"id":"ops","node":"users","shape":{"kind":"constant","rps":10000},"readRatio":0.7,"keys":{"kind":"zipf","s":0.9}}],"events":[]},
  "wire": {
    "host": "kv.internal",
    "read": {
      "method": "GET",
      "path": "/v1/kv/{code}",
      "status": 200,
      "body": "{\"key\": \"{code}\", \"value\": {value}, \"version\": 3}"
    },
    "write": {
      "method": "PUT",
      "path": "/v1/kv/{code}",
      "reqBody": "{\"value\": {value}}",
      "status": 200,
      "body": "{\"key\": \"{code}\", \"version\": 4}"
    },
    "table": "kv",
    "keyCol": "k",
    "valCol": "v"
  }
}
