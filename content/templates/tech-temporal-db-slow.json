{
  "schemaVersion": 1,
  "id": "tech-temporal-db-slow",
  "name": "Temporal: slow persistence",
  "description": "Every history event is a database write before anything moves. Slow the database and every workflow slows with it — but nothing is lost.",
  "nodes": [
    {
      "id": "app",
      "type": "web-client",
      "name": "Checkout app",
      "pos": {
        "x": 55,
        "y": 0
      }
    },
    {
      "id": "frontend",
      "type": "temporal-frontend",
      "name": "Frontend",
      "pos": {
        "x": 55,
        "y": 120
      }
    },
    {
      "id": "history",
      "type": "temporal-history",
      "name": "History",
      "pos": {
        "x": -100,
        "y": 240
      }
    },
    {
      "id": "matching",
      "type": "temporal-matching",
      "name": "Matching",
      "pos": {
        "x": 210,
        "y": 240
      }
    },
    {
      "id": "db",
      "type": "temporal-persistence",
      "skin": "temporal-cassandra",
      "name": "Persistence",
      "pos": {
        "x": -100,
        "y": 360
      }
    },
    {
      "id": "worker-1",
      "type": "temporal-worker",
      "name": "Worker 1",
      "pos": {
        "x": 117,
        "y": 360
      }
    },
    {
      "id": "worker-2",
      "type": "temporal-worker",
      "name": "Worker 2",
      "pos": {
        "x": 288,
        "y": 360
      }
    }
  ],
  "edges": [
    {
      "id": "e-app",
      "from": "app",
      "to": "frontend"
    },
    {
      "id": "e-fh",
      "from": "frontend",
      "to": "history"
    },
    {
      "id": "e-fm",
      "from": "frontend",
      "to": "matching"
    },
    {
      "id": "e-hdb",
      "from": "history",
      "to": "db"
    },
    {
      "id": "e-hm",
      "from": "history",
      "to": "matching",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "e-w1",
      "from": "worker-1",
      "to": "frontend"
    },
    {
      "id": "e-w2",
      "from": "worker-2",
      "to": "frontend"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 180,
    "sources": [
      {
        "id": "starts",
        "node": "app",
        "shape": {
          "kind": "constant",
          "rps": 1
        },
        "readRatio": 1
      }
    ],
    "events": []
  },
  "wire": {
    "host": "api.travelbook.com",
    "read": {
      "path": "/v1/bookings/{key}",
      "body": "{\"workflow_id\": \"booking-{key}\", \"status\": \"RUNNING\"}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/bookings",
      "reqBody": "{\"hotel_id\": {key}, \"nights\": 3}",
      "status": 202,
      "body": "{\"workflow_id\": \"booking-{key}\"}"
    }
  }
}
