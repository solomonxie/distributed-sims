{
  "schemaVersion": 1,
  "id": "problem-twitch-v2",
  "name": "Twitch — reference",
  "description": "Low-latency CDN (short TTL, origin shield) in front of the live origin; chat goes through pub/sub to a fleet of websocket edges.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "skin": "react-spa",
      "name": "Viewers",
      "pos": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "cdn",
      "type": "cdn",
      "skin": "fastly",
      "name": "Live CDN (2s segments)",
      "pos": {
        "x": -90,
        "y": 110
      },
      "config": {
        "ttlSec": 4,
        "cacheablePct": 99
      }
    },
    {
      "id": "origin",
      "type": "service",
      "skin": "go-service",
      "name": "Live origin (transcode + package)",
      "pos": {
        "x": -90,
        "y": 220
      },
      "config": {
        "instances": 2,
        "slots": 32,
        "p50Ms": 20,
        "p99Ms": 80
      }
    },
    {
      "id": "alb",
      "type": "load-balancer",
      "skin": "aws-alb",
      "name": "Load balancer",
      "pos": {
        "x": 90,
        "y": 110
      }
    },
    {
      "id": "chat",
      "type": "service",
      "skin": "go-service",
      "name": "Chat API",
      "pos": {
        "x": 90,
        "y": 220
      },
      "config": {
        "instances": 2
      }
    },
    {
      "id": "fanout",
      "type": "log-stream",
      "skin": "kafka",
      "name": "Chat log (by channel)",
      "pos": {
        "x": 90,
        "y": 330
      },
      "config": {
        "partitions": 12
      }
    },
    {
      "id": "edges",
      "type": "worker",
      "name": "Websocket edges",
      "pos": {
        "x": 90,
        "y": 440
      },
      "config": {
        "instances": 6,
        "slots": 64,
        "p50Ms": 2,
        "p99Ms": 10,
        "idempotent": true
      }
    },
    {
      "id": "chatdb",
      "type": "kv-store",
      "skin": "cassandra",
      "name": "Chat history",
      "pos": {
        "x": -30,
        "y": 330
      }
    }
  ],
  "edges": [
    {
      "id": "users->cdn",
      "from": "users",
      "to": "cdn",
      "config": {
        "op": "read"
      }
    },
    {
      "id": "users->alb",
      "from": "users",
      "to": "alb",
      "config": {
        "op": "write"
      }
    },
    {
      "id": "cdn->origin",
      "from": "cdn",
      "to": "origin"
    },
    {
      "id": "alb->chat",
      "from": "alb",
      "to": "chat"
    },
    {
      "id": "chat->fanout",
      "from": "chat",
      "to": "fanout",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "chat->chatdb",
      "from": "chat",
      "to": "chatdb",
      "config": {
        "mode": "async"
      }
    },
    {
      "id": "fanout->edges",
      "from": "fanout",
      "to": "edges"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 60,
    "sources": [
      {
        "id": "viewers",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 500
        },
        "readRatio": 1
      },
      {
        "id": "chat",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 200
        },
        "readRatio": 0
      }
    ],
    "events": []
  },
  "wire": {
    "host": "api.twitch.example",
    "read": {
      "method": "GET",
      "path": "/v1/streams/{key}",
      "status": 200,
      "body": "{\"channel_id\": {key}, \"live\": true, \"hls\": \"/hls/{key}/index.m3u8\", \"viewers\": 18234}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/channels/{key}/chat",
      "reqBody": "{\"text\": \"PogChamp\"}",
      "status": 201,
      "body": "{\"msg_id\": \"{code}\", \"sent_at\": \"2026-09-27T09:00:00Z\"}"
    },
    "table": "chat_messages",
    "valCol": "text",
    "topic": "chat-fanout"
  }
}
