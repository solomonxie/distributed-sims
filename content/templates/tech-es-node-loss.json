{
  "schemaVersion": 1,
  "id": "tech-es-node-loss",
  "name": "Elasticsearch: losing a data node",
  "description": "3 data nodes, 3 primaries + 1 replica each. Delayed allocation is 5s (real default 1 minute).",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 239,
        "y": 10
      },
      "config": {}
    },
    {
      "id": "app",
      "type": "es-app",
      "name": "app",
      "pos": {
        "x": 239,
        "y": 80
      },
      "config": {}
    },
    {
      "id": "coord",
      "type": "es-coord",
      "name": "coordinating",
      "pos": {
        "x": 239,
        "y": 170
      },
      "config": {}
    },
    {
      "id": "m1",
      "type": "es-master",
      "name": "master-1",
      "pos": {
        "x": 70,
        "y": 290
      },
      "config": {}
    },
    {
      "id": "m2",
      "type": "es-master",
      "name": "master-2",
      "pos": {
        "x": 239,
        "y": 290
      },
      "config": {}
    },
    {
      "id": "m3",
      "type": "es-master",
      "name": "master-3",
      "pos": {
        "x": 408,
        "y": 290
      },
      "config": {}
    },
    {
      "id": "d1",
      "type": "es-data",
      "name": "data-1",
      "pos": {
        "x": 70,
        "y": 420
      },
      "config": {}
    },
    {
      "id": "d2",
      "type": "es-data",
      "name": "data-2",
      "pos": {
        "x": 239,
        "y": 420
      },
      "config": {}
    },
    {
      "id": "d3",
      "type": "es-data",
      "name": "data-3",
      "pos": {
        "x": 408,
        "y": 420
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "e-users-app",
      "from": "users",
      "to": "app"
    },
    {
      "id": "e-app-coord",
      "from": "app",
      "to": "coord"
    },
    {
      "id": "e-coord-d1",
      "from": "coord",
      "to": "d1",
      "config": {
        "timeoutMs": 1000
      }
    },
    {
      "id": "e-coord-d2",
      "from": "coord",
      "to": "d2",
      "config": {
        "timeoutMs": 1000
      }
    },
    {
      "id": "e-coord-d3",
      "from": "coord",
      "to": "d3",
      "config": {
        "timeoutMs": 1000
      }
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 120,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 500
        },
        "readRatio": 0.8
      }
    ],
    "events": []
  },
  "wire": {
    "host": "help.example.com",
    "read": {
      "method": "GET",
      "path": "/api/articles/search?q=refund&page={key}",
      "status": 200,
      "body": "{\"total\": 57, \"hits\": [{\"id\": {key}}]}"
    },
    "write": {
      "method": "PUT",
      "path": "/api/articles/{key}",
      "reqBody": "{\"title\": \"Refund policy\", \"rev\": {value}}",
      "status": 200,
      "body": "{\"id\": {key}, \"result\": \"updated\"}"
    }
  }
}