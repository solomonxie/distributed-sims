{
  "schemaVersion": 1,
  "id": "tech-nginx-blocking",
  "name": "nginx: a blocking call stalls a worker",
  "description": "Each worker serves thousands of connections on one thread — so one blocking call (sync DNS, disk on NFS, a slow Lua socket) freezes every connection on that worker.",
  "nodes": [
    {
      "id": "users",
      "type": "web-client",
      "name": "Users",
      "pos": {
        "x": 195,
        "y": 40
      }
    },
    {
      "id": "nginx",
      "type": "nginx-server",
      "name": "nginx",
      "pos": {
        "x": 195,
        "y": 170
      },
      "skin": "nginx-internals",
      "config": {
        "workers": 4,
        "staticRatio": 0.5
      }
    },
    {
      "id": "app",
      "type": "service",
      "name": "app upstream",
      "pos": {
        "x": 195,
        "y": 300
      },
      "config": {
        "instances": 4,
        "slots": 64,
        "p50Ms": 5,
        "p99Ms": 20
      }
    }
  ],
  "edges": [
    {
      "id": "users-nginx",
      "from": "users",
      "to": "nginx",
      "config": {
        "timeoutMs": 3000
      }
    },
    {
      "id": "nginx-app",
      "from": "nginx",
      "to": "app"
    }
  ],
  "containers": [],
  "scenario": {
    "durationSec": 300,
    "sources": [
      {
        "id": "s1",
        "node": "users",
        "shape": {
          "kind": "constant",
          "rps": 3000
        }
      }
    ],
    "events": []
  },
  "wire": {
    "host": "api.weatherly.io",
    "read": {
      "path": "/v1/forecast/{key}",
      "body": "{\"city_id\": {key}, \"temp_c\": {value}, \"sky\": \"cloudy\"}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/alerts",
      "reqBody": "{\"city_id\": {key}, \"min_temp_c\": {value}}",
      "status": 201,
      "body": "{\"alert_id\": {key}}"
    }
  }
}
