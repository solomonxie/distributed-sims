{
  "schemaVersion": 1,
  "id": "problem-craigslist-v2",
  "name": "Craigslist: regional shards, search, object store",
  "description": "Listings are sharded by region; each post is indexed within ~1s refresh. Photos go to S3 behind a CDN, so the database only holds small rows.",
  "nodes": [
    {"id":"users","type":"web-client","skin":"react-spa","name":"Visitors","pos":{"x":105,"y":0}},
    {"id":"cdn","type":"cdn","skin":"cloudfront","name":"CDN (photos)","pos":{"x":105,"y":110},"config":{"cacheablePct":60}},
    {"id":"lb","type":"load-balancer","skin":"aws-alb","name":"Load balancer","pos":{"x":105,"y":220}},
    {"id":"api","type":"service","skin":"go-service","name":"Listings API","pos":{"x":105,"y":330},"config":{"instances":3}},
    {"id":"router","type":"shard-router","skin":"vitess","name":"Region router","pos":{"x":-82,"y":440},"config":{"shardBy":"range"}},
    {"id":"search","type":"search-index","skin":"elasticsearch","name":"Search","pos":{"x":105,"y":440},"config":{"instances":4,"replicas":2}},
    {"id":"s3","type":"object-store","skin":"s3","name":"Photos (S3)","pos":{"x":292,"y":440}},
    {"id":"db-us","type":"relational-db","skin":"postgres","name":"Listings: Americas","pos":{"x":-150,"y":550}},
    {"id":"db-eu","type":"relational-db","skin":"postgres","name":"Listings: EMEA","pos":{"x":20,"y":550}}
  ],
  "edges": [
    {"id":"users-cdn","from":"users","to":"cdn","config":{"timeoutMs":5000}},
    {"id":"cdn-lb","from":"cdn","to":"lb"},
    {"id":"lb-api","from":"lb","to":"api"},
    {"id":"api-search","from":"api","to":"search","config":{"op":"any"}},
    {"id":"api-router","from":"api","to":"router","config":{"op":"write"}},
    {"id":"api-s3","from":"api","to":"s3","config":{"op":"write"}},
    {"id":"router-db-us","from":"router","to":"db-us"},
    {"id":"router-db-eu","from":"router","to":"db-eu"}
  ],
  "containers": [],
  "scenario": {"durationSec":60,"sources":[{"id":"visits","node":"users","shape":{"kind":"constant","rps":3000},"readRatio":0.98,"keys":{"kind":"uniform"}}],"events":[]},
  "wire": {
    "host": "api.craigslist.example",
    "read": {
      "method": "GET",
      "path": "/v1/listings/{key}",
      "status": 200,
      "body": "{\"id\": {key}, \"title\": \"Road bike, 56cm\", \"price\": 450, \"region\": \"sfbay\"}"
    },
    "write": {
      "method": "POST",
      "path": "/v1/listings",
      "reqBody": "{\"title\": \"Road bike, 56cm\", \"price\": {value}, \"region\": \"sfbay\"}",
      "status": 201,
      "body": "{\"id\": {key}, \"status\": \"active\"}"
    },
    "table": "listings",
    "valCol": "price"
  }
}
